---
const { items } = Astro.props;
---
<div class="space-y-4">
  {items.map((item) => (
    <details class="qa group scroll-reveal rounded-2xl border border-[#d5d0c4]/40 bg-white shadow-sm">
      <summary class="flex items-start justify-between gap-4 p-6">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#14b8a6] to-[#5eead4] text-xs font-bold text-white">?</span>
          <span class="text-lg font-bold text-[#0f766e]">{item.q}</span>
        </div>
        <svg class="qa-chevron mt-1 h-5 w-5 shrink-0 text-[#14b8a6]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </summary>
      <div class="px-6 pb-6 pl-[4.25rem]">
        <p class="leading-relaxed text-[#5c5a4c]">{item.a}</p>
      </div>
    </details>
  ))}
</div>
