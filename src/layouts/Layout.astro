---
import "../styles/global.css";
import { SITE, NAV } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? SITE.title;
const description = Astro.props.description ?? SITE.description;
const ogImage = new URL("/images/og.jpg", SITE.url).href;
const canonical = Astro.url.pathname === "/"
  ? new URL("/", SITE.url).href.replace(/\/$/, "")
  : new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LNMPFVMGYH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LNMPFVMGYH');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" /></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Karst peaks of Guilin at golden hour — China Nature's ultimate guide to natural landscapes" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="keywords" content="China nature, nature in China, China natural wonders, China national parks, China landscapes, China wildlife, karst China, danxia China, China hiking trails, China nature travel, China trip planner, best nature places in China" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "China Nature",
      "url": "https://www.chinanaturetrip.com",
      "description": "Independent guide to China's nature — karst peaks, danxia cliffs, glaciers, deserts, lakes and wildlife. Find your perfect landscape with the trip finder.",
      "inLanguage": "en"
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "China Nature",
      "url": "https://www.chinanaturetrip.com",
      "logo": "https://www.chinanaturetrip.com/favicon.svg",
      "description": "Independent guide to China's natural landscapes and wildlife.",
      "sameAs": []
    }
    </script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById("mobile-menu-btn");
        const menu = document.getElementById("mobile-menu");
        if (btn && menu) {
          btn.addEventListener("click", () => {
            const open = menu.classList.toggle("hidden");
            btn.setAttribute("aria-expanded", String(!open));
          });
          menu.addEventListener("click", (e) => {
            if (e.target.closest("a")) { menu.classList.add("hidden"); btn.setAttribute("aria-expanded", "false"); }
          });
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
        const header = document.getElementById('site-header');
        window.addEventListener('scroll', () => {
          if (header) header.classList.toggle('nav-scrolled', window.scrollY > 60);
        });
      });
    </script>
  </head>
  <body class="min-h-dvh bg-[#f8f7f4] text-[#1c1a16] antialiased">
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="organic-blob organic-blob-1" style="width:600px;height:600px;top:-200px;right:-150px;"></div>
      <div class="organic-blob organic-blob-2" style="width:400px;height:400px;bottom:10%;left:-100px;"></div>
      <div class="organic-blob organic-blob-3" style="width:500px;height:500px;bottom:-150px;right:-200px;"></div>
    </div>

    <header id="site-header" class="fixed top-0 z-50 w-full transition-all duration-300">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
        <a href="#top" class="relative z-10 flex items-center gap-3 group">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-white shadow-lg shadow-[#0f766e]/15 transition-all group-hover:shadow-xl group-hover:scale-105">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20L9 8l3 6 3-9 6 15H3z"/></svg>
          </span>
          <span class="text-lg font-bold tracking-tight text-[#0f766e]">China Nature</span>
        </a>
        <ul class="hidden items-center gap-1 text-sm font-medium lg:flex">
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="nav-link relative px-4 py-2 rounded-full text-[#5c5a4c] transition-all duration-300 hover:text-[#0f766e] hover:bg-[#ccfbf1]/15">
                {item.label}
                <span class="nav-indicator"></span>
              </a>
            </li>
          ))}
          <li class="ml-3">
            <a href="#trip-finder" class="rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-[#0f766e]/15 transition-all hover:shadow-lg hover:scale-105">
              Find My Trip
            </a>
          </li>
        </ul>
        <button id="mobile-menu-btn" class="lg:hidden relative z-10 flex h-10 w-10 items-center justify-center rounded-xl bg-white/80 backdrop-blur border border-[#d5d0c4] text-[#0f766e]" aria-label="Toggle menu" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </nav>
      <div id="mobile-menu" class="hidden border-b border-[#d5d0c4] bg-white/95 backdrop-blur-xl px-6 py-6 lg:hidden">
        <ul class="space-y-1 text-sm font-medium">
          {NAV.map((item) => (
            <li><a href={item.href} class="block rounded-xl px-4 py-3 text-[#5c5a4c] transition-all hover:bg-[#ccfbf1]/10 hover:text-[#0f766e]">{item.label}</a></li>
          ))}
          <li class="pt-3 mt-1 border-t border-[#d5d0c4]">
            <a href="#trip-finder" class="block rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-4 py-3 text-center font-semibold text-white">Find My Trip</a>
          </li>
        </ul>
      </div>
    </header>

    <main class="relative z-10"><slot /></main>

    <div class="mountain-divider"></div>

    <footer class="relative z-10 bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] pt-16 pb-12">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid gap-12 md:grid-cols-2">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-white text-sm font-bold">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20L9 8l3 6 3-9 6 15H3z"/></svg>
              </span>
              <span class="text-lg font-bold tracking-tight text-[#0f766e]">China Nature</span>
            </div>
            <p class="max-w-xs text-sm leading-relaxed text-[#5c5a4c]">Independent guide to China's natural landscapes. No tour sales, no sponsored fluff — just honest advice and a tool that helps you decide.</p>
            <p class="mt-4 text-sm text-[#5c5a4c]">Contact: <a href="mailto:hello@chinanaturetrip.com" class="text-[#0f766e] hover:underline">hello@chinanaturetrip.com</a></p>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-[#2dd4bf] mb-4">Explore</p>
            <ul class="space-y-3 text-sm">
              <li><a href="#trip-finder" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Trip Finder</a></li>
              <li><a href="#landscapes" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Landscapes</a></li>
              <li><a href="#compare" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Compare Destinations</a></li>
              <li><a href="#wildlife" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Wildlife</a></li>
              <li><a href="#itineraries" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Itineraries</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-[#d4a373] mb-4">Deep Guides</p>
            <ul class="space-y-3 text-sm">
              <li><a href="#landscapes" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">10 Landscapes</a></li>
              <li><a href="#compare" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Compare Destinations</a></li>
              <li><a href="#wildlife" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Wildlife</a></li>
              <li><a href="#itineraries" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Itineraries</a></li>
              <li><a href="#food" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">What to Eat</a></li>
              <li><a href="#stay" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Where to Stay</a></li>
              <li><a href="#transport" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Getting Around</a></li>
              <li><a href="#packing" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">What to Wear</a></li>
              <li><a href="#plan" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Plan Your Trip</a></li>
              <li><a href="#mistakes" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Mistakes to Avoid</a></li>
              <li><a href="#photography" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Photography</a></li>
              <li><a href="#guides" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Destination Guides</a></li>
              <li><a href="#faq" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">FAQ</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-[#d5d0c4] text-center">
          <p class="text-xs text-[#5c5a4c]/60">Independent travel guide. Not affiliated with any tour agency or hotel. © 2026 China Nature · <a href="mailto:hello@chinanaturetrip.com" class="hover:underline">Contact</a> · We use privacy-respecting analytics and collect no personal data.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  #site-header.nav-scrolled {
    background: rgba(248, 247, 244, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(181, 176, 165, 0.2);
  }
</style>
