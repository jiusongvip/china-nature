---
import Layout from "../layouts/Layout.astro";

const title = "China Nature Terms of Use — Content & Liability";
const description = "Terms of use for chinanaturetrip.com: informational content only, no warranties, limitations of liability, intellectual property and acceptable use.";
---

<Layout title={title} description={description}>
  <section class="relative border-b border-[#d5d0c4] bg-white py-16">
    <div class="mx-auto max-w-3xl px-6">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs font-semibold text-[#78716c]"><a href="/" class="hover:text-[#0f766e]">Home</a> <span class="mx-1">/</span> <span class="text-[#0f766e]">Terms of Use</span></nav>
      <span class="tag tag-primary mb-4">Legal</span>
      <h1 class="font-display text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Terms of Use</h1>
      <p class="mt-5 text-lg leading-relaxed text-[#5c5a4c]">Last updated: September 5, 2026</p>
    </div>
  </section>

  <section class="relative py-16">
    <div class="mx-auto max-w-3xl space-y-8 px-6 text-[#5c5a4c]">
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">1. Acceptance</h2>
        <p class="mt-3 leading-relaxed">By using chinanaturetrip.com you agree to these terms. If you do not agree, please do not use the site.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">2. Informational content</h2>
        <h3 class="mt-3 text-lg font-semibold text-[#1c1a16]">Verify before you travel</h3>
        <p class="mt-2 leading-relaxed">All content is general travel information, provided in good faith and based on firsthand visits at the time of writing. Prices, opening hours, visa rules and transport conditions in China change frequently — always verify critical details with official sources before you rely on them.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">3. No warranties</h2>
        <p class="mt-3 leading-relaxed">The site is provided "as is" without warranties of any kind. We do not guarantee that any itinerary, cost estimate or seasonal advice will suit your circumstances.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">4. Limitation of liability</h2>
        <p class="mt-3 leading-relaxed">To the maximum extent permitted by law, China Nature is not liable for any loss arising from the use of this site, including travel disruptions, costs or safety incidents. Travel — especially at altitude or in remote areas — carries inherent risks; assess them yourself and prepare accordingly.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">5. Intellectual property</h2>
        <h3 class="mt-3 text-lg font-semibold text-[#1c1a16]">Text and photographs</h3>
        <p class="mt-2 leading-relaxed">Text and photographs on this site are © China Nature unless stated otherwise. You may quote short passages with a visible link back; you may not republish whole articles or images without written permission. Icons are from Font Awesome (CC BY 4.0).</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">6. Acceptable use</h2>
        <p class="mt-3 leading-relaxed">Do not attempt to disrupt the site, scrape it at scale, or use its content to train commercial AI systems without permission. Personal, non-commercial reading and quoting with attribution is welcome — see our <a href="/privacy/" class="font-semibold text-[#0f766e] underline hover:no-underline">privacy policy</a>.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">7. Contact</h2>
        <p class="mt-3 leading-relaxed">Questions about these terms: <a href="mailto:hello@chinanaturetrip.com" class="font-semibold text-[#0f766e] underline hover:no-underline">hello@chinanaturetrip.com</a>.</p>
      </div>
    </div>
  </section>
</Layout>
