      </div>
    </div>
  </section>

  <!-- 9. Practical -->
  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-stone mb-4">Before You Fly</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">The Practical Stuff</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Four things that stress people out — solved.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {practical.map((p) => (
          <div class="scroll-reveal rounded-2xl border border-[#d5d0c4]/40 bg-white p-7 shadow-sm">
            <i class={`fa-solid ${p.icon} text-2xl`} style={`color: ${p.color}`}></i>
            <h3 class="mt-3 text-lg font-bold text-[#1c1a16]">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9b. Step-by-step plan -->
  <section id="plan" class="relative bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] py-20 md:py-28">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">Plan It</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Plan Your Trip in 6 Steps</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">The order matters — book the scarce things first and everything else falls into place.</p>
      </div>
      <ol class="space-y-4">
        {planSteps.map((p, i) => (
          <li class="scroll-reveal flex gap-4 rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#0f766e] to-[#5eead4] font-bold text-white">{i + 1}</span>
            <div>
              <h3 class="text-lg font-bold text-[#1c1a16]">{p.step}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{p.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 9c. Mistakes to avoid -->
  <section id="mistakes" class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-warm mb-4">Don't Do This</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">10 Mistakes That Cost Travelers a Day</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Learn from the people who got it wrong, so you don't.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {mistakes.map((m) => (
          <div class="scroll-reveal rounded-2xl border border-[#d5d0c4]/40 bg-white p-5 shadow-sm">
            <p class="font-bold text-[#1c1a16]"><i class="fa-solid fa-triangle-exclamation mr-2 text-[#d4a373]"></i>{m.mistake}</p>
            <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{m.fix}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9d. Photography -->
  <section id="photography" class="relative bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-stone mb-4">Photography</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Get the Shot You Came For</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Six frames worth crossing the world for — and how to nail each one.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {photography.map((p) => (
          <div class="card-playful scroll-reveal rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-[#1c1a16]">{p.spot}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[#5c5a4c]">{p.tip}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section id="faq" class="relative py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-12">
        <span class="tag tag-primary mb-4">Quick Answers</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Frequently Asked Questions</h2>
      </div>
      <Faq items={faqItems} />
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    </div>
  </section>

  <!-- 11. Heritage sites -->
  <section class="relative border-t border-[#d5d0c4] bg-white py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-8 text-center">
        <span class="tag tag-warm mb-4">The Official List</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">14 World Natural Heritage Sites</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">China has more natural World Heritage sites than any other country. Here's the full list.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {heritageSites.map((site, i) => (
          <a href={site.url} target="_blank" rel="noopener" class="group flex items-center gap-3 rounded-xl border border-[#d5d0c4]/40 bg-[#f8f7f4] px-4 py-3 transition-colors hover:border-[#14b8a6]/50 hover:bg-white">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-xs font-bold text-white">{i + 1}</span>
            <span class="text-sm font-medium text-[#1c1a16] group-hover:text-[#0f766e]">{site.name}</span>
            <i class="fa-solid fa-arrow-up-right-from-square ml-auto text-[10px] text-[#a8a29e]"></i>
          </a>
        ))}
      </div>
      <p class="mt-8 text-center text-xs text-[#5c5a4c]/70">Source: <a href="https://whc.unesco.org/en/statesparties/cn" target="_blank" rel="noopener" class="underline hover:text-[#0f766e]">UNESCO World Heritage Centre — China</a>.</p>
    </div>
  </section>

  <!-- 11b. Sister-site network -->
  <section id="guides" class="relative border-t border-[#d5d0c4] bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">Go Deeper</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Explore Our Destination Guides</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">In-depth, independent guides to the places above — written the same honest way, with no tour sales.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sisterSites.map((site) => (
          <a href={site.url} target="_blank" rel="noopener" class="card-playful scroll-reveal group flex flex-col rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#ccfbf1]/60 text-[#0f766e]"><i class={`fa-solid ${site.icon} text-xl`}></i></div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#14b8a6]">{site.tag}</span>
            <h3 class="mt-2 text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">{site.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{site.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#0f766e]">Read guide <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. Author -->
  <section class="relative border-t border-[#d5d0c4] bg-[#edeae3] py-16">
    <div class="mx-auto max-w-4xl px-6">
      <div class="flex flex-col items-center gap-6 rounded-3xl border border-[#d5d0c4]/40 bg-white p-8 text-center shadow-sm md:flex-row md:text-left">
        <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-2xl font-bold text-white">{author.name.charAt(0)}</span>
        <div>
          <p class="text-lg font-bold text-[#1c1a16]">{author.name}</p>
          <p class="text-sm font-semibold text-[#0f766e]">{author.role}</p>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#5c5a4c]">{author.bio}</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(top10Schema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(destinationSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)}></script>
</Layout>
