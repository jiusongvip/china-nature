---
import Layout from "../layouts/Layout.astro";
import TripFinder from "../components/TripFinder.astro";
import Icon from "../components/Icon.astro";

// ── 10 landform families (the differentiator) ──
// ── Trip Finder destinations ──
const destinations = [
  { name: "Guilin & Yangshuo", landscape: "karst", landscapeLabel: "Karst", seasons: ["spring", "summer", "autumn"], difficulty: "easy", altitude: "low", days: "3–4 days", reason: "Iconic karst peaks, bamboo rafts and bike rides through rice fields — the classic China postcard.", guide: { location: "Guangxi, southern China", ticket: "Li River cruise ~CNY 360; parks from CNY 60", transport: "Fly to Guilin (KWL) or high-speed rail from Guangzhou (2.5h)", tips: "Skip the big boats — a Yulong River bamboo raft is quieter and prettier" }, url: "https://guilin-yang-shuo.com" },
  { name: "Zhangjiajie", landscape: "mountains", landscapeLabel: "Mountains", seasons: ["spring", "autumn"], difficulty: "moderate", altitude: "low", days: "3 days", reason: "3,000 sandstone pillars that inspired Avatar, plus the world's tallest outdoor elevator.", guide: { location: "Hunan, 32km from Zhangjiajie city", ticket: "Forest park ~CNY 225 (4-day); elevators extra", transport: "High-speed rail to Zhangjiajie West, then shuttle to Wulingyuan gate", tips: "Stay in Wulingyuan and enter at opening time to beat elevator queues" }, url: "https://zhangjiajie-national-park.com" },
  { name: "Jiuzhaigou Valley", landscape: "lakes", landscapeLabel: "Lakes", seasons: ["autumn"], difficulty: "easy", altitude: "moderate", days: "2–3 days", reason: "Unreal turquoise lakes, waterfalls and snow peaks in a Tibetan valley — best in autumn color.", guide: { location: "Sichuan, 400km north of Chengdu", ticket: "~CNY 169–280; advance reservation required", transport: "Fly from Chengdu (1h) or bus (8h); book tickets online first", tips: "Go in late October for peak color, enter at 7am, buy tickets days ahead" } },
  { name: "Huangshan", landscape: "mountains", landscapeLabel: "Mountains", seasons: ["year-round"], difficulty: "moderate", altitude: "moderate", days: "2–3 days", reason: "The 'loveliest mountain of China' — granite pines, cloud seas and sunrise above the mist.", guide: { location: "Anhui, 1.5h from Huangshan city", ticket: "~CNY 190 + cable cars ~CNY 80–90", transport: "High-speed rail to Huangshan North, then bus to the scenic area", tips: "Stay one night on the summit to catch sunrise without the dawn climb" } },
  { name: "Zhangye Danxia", landscape: "danxia", landscapeLabel: "Danxia", seasons: ["year-round"], difficulty: "easy", altitude: "low", days: "1–2 days", reason: "Rainbow-striped hills that look like a painting — most vivid at sunrise and sunset.", guide: { location: "Gansu, 40km from Zhangye city", ticket: "~CNY 75 + shuttle bus", transport: "Fly or high-speed rail to Zhangye, then taxi to the park", tips: "Go at sunset; the west gate has shorter lines than the main entrance" } },
  { name: "Dunhuang & Gobi", landscape: "deserts", landscapeLabel: "Deserts", seasons: ["spring", "autumn"], difficulty: "easy", altitude: "low", days: "3 days", reason: "Singing sand dunes, the Crescent Lake oasis and Mogao Caves on the Silk Road.", guide: { location: "Gansu, far west on the Silk Road", ticket: "Mogao Caves from CNY 238 (book ahead); dunes ~CNY 110", transport: "Fly to Dunhuang from Lanzhou/Xi'an, or overnight train", tips: "Mogao Caves sells out — reserve a week ahead; hit the dunes at dusk" }, url: "https://dunhuang-jiuquan.com" },
  { name: "Hulunbuir Grassland", landscape: "grasslands", landscapeLabel: "Grasslands", seasons: ["summer"], difficulty: "easy", altitude: "low", days: "3 days", reason: "China's largest prairie — endless green, horse riding and Mongolian yurt stays in summer.", guide: { location: "Inner Mongolia, on the Russian border", ticket: "Grassland access via tour/camp, ~CNY 100–300", transport: "Fly to Hailar (HLD) from Beijing, then rent a car or join a tour", tips: "Go June–August for green grass; book yurt stays ahead in July" } },
  { name: "Hailuogou Glacier", landscape: "glaciers", landscapeLabel: "Glaciers", seasons: ["winter", "spring"], difficulty: "moderate", altitude: "high", days: "2–3 days", reason: "A rare low-altitude glacier with an ice fall, hot springs and views of Mount Gongga.", guide: { location: "Sichuan, 300km from Chengdu", ticket: "~CNY 90 + cable car CNY 150", transport: "Bus from Chengdu (6h) via Luding, or drive", tips: "Winter has the clearest views; book the hot-spring hotel inside the park" } },
  { name: "Xishuangbanna", landscape: "forests", landscapeLabel: "Forests", seasons: ["winter", "spring"], difficulty: "easy", altitude: "low", days: "3 days", reason: "China's only tropical rainforest — wild elephants, tea mountains and Dai culture.", guide: { location: "Yunnan, on the Laos border", ticket: "Botanical Garden ~CNY 75; Elephant Valley ~CNY 80", transport: "Fly to Jinghong (JHG) from Kunming or Chongqing", tips: "Come in winter for dry, cool weather; see elephants at morning feeding" }, url: "https://yunnan-province.com" },
  { name: "Yellow River Delta", landscape: "wetlands", landscapeLabel: "Wetlands", seasons: ["autumn", "winter"], difficulty: "easy", altitude: "low", days: "1–2 days", reason: "A migratory-bird sanctuary where the Yellow River meets the sea — a red suaeda 'carpet' in autumn.", guide: { location: "Shandong, at the Yellow River mouth", ticket: "~CNY 60–90", transport: "Drive or take a bus from Dongying city", tips: "Autumn (Sep–Nov) brings the red suaeda carpet and peak bird migration" } },
  { name: "Shangri-La", landscape: "plateau", landscapeLabel: "Plateau", seasons: ["spring", "autumn"], difficulty: "moderate", altitude: "high", days: "3–4 days", reason: "Tibetan plateau at 3,200m — alpine lakes, monasteries and snow-capped gorges.", guide: { location: "Yunnan, at 3,200m altitude", ticket: "Songzanlin Monastery ~CNY 90; Pudacuo Park ~CNY 100", transport: "Fly to Diqing (DIG) from Kunming/Chengdu, or bus from Lijiang", tips: "Spend the first night acclimatizing; carry layers even in summer" }, url: "https://shangri-la-yunnan.com" },
  { name: "Tibet & Lhasa", landscape: "plateau", landscapeLabel: "Plateau", seasons: ["summer", "autumn"], difficulty: "challenging", altitude: "very-high", days: "4–7 days", reason: "The Roof of the World — Potala Palace, turquoise lakes and Himalayan passes.", guide: { location: "Tibet Autonomous Region, 3,650m altitude", ticket: "Potala Palace ~CNY 200 (book ahead)", transport: "Fly to Lhasa from Chengdu/Xi'an, or the Qinghai–Tibet railway", tips: "Foreign travelers need a Tibet permit via an agency; acclimatize 2 days in Lhasa" }, url: "https://tibet-lhasa-potala.com" },
];

// ── Label maps for the destination cheat-sheet table ──
const seasonLabelMap = { spring: "Spring", summer: "Summer", autumn: "Autumn", winter: "Winter", "year-round": "Year-round" };
const difficultyLabelMap = { easy: "Easy", moderate: "Moderate", challenging: "Challenging" };
const altitudeLabelMap = { low: "Low", moderate: "1,500–3,000m", high: "3,000–4,500m", "very-high": "4,500m+" };

// ── Comparison table ──
const comparison = {
  columns: ["Zhangjiajie", "Guilin & Yangshuo", "Jiuzhaigou"],
  rows: [
    { label: "Landscape", values: ["Sandstone pillar forest", "Karst peaks & rivers", "Alpine lakes & waterfalls"] },
    { label: "Best season", values: ["Apr–Oct", "Apr–Nov", "Sep–Oct"] },
    { label: "Difficulty", values: ["Moderate", "Easy", "Easy"] },
    { label: "Altitude", values: ["Low", "Low", "~2,000–3,000m"] },
    { label: "Days needed", values: ["3 days", "3–4 days", "2–3 days"] },
    { label: "Best for", values: ["Adventure & drama", "Easy scenery & cycling", "Photography & color"] },
    { label: "Verdict", values: ["Pick for wow-factor peaks", "Pick for first-timers", "Pick for unreal lakes"] },
  ],
};

// ── Wildlife ──
const wildlife = [
  { name: "Giant Panda", img: "/images/wildlife-panda.webp", imgAlt: "Giant panda eating bamboo at Dujiangyan Panda Base in Sichuan, China", initial: "P", where: "Sichuan — Wolong & Chengdu bases", fact: "~1,800 left in the wild", detail: "See pandas at the Chengdu Panda Base (easy day trip) or the less-crowded Dujiangyan base. Go at 8–10am when pandas are most active and feeding. For a near-wild experience, Wolong Nature Reserve's forested enclosures are the closest thing.", url: "https://dujiangyan-panda-base.com" },
  { name: "Snow Leopard", initial: "S", where: "Tibet & Qinghai plateau", fact: "The ghost of the mountains", detail: "Almost impossible to see in the wild — your best odds are winter wildlife-watching trips in Qinghai's Sanjiangyuan region, with local trackers, spotting scopes and a lot of patience." },
  { name: "Golden Snub-nosed Monkey", img: "/images/wildlife-snub-nosed-monkey.webp", imgAlt: "Golden snub-nosed monkey perched in a forest in China", initial: "G", where: "Sichuan, Shaanxi & Hubei", fact: "Blue-faced mountain acrobats", detail: "Easily seen in Shennongjia (Hubei) and the Qinling Mountains — blue-faced monkeys with golden fur that come close to winter feeding stations." },
  { name: "Tibetan Antelope", initial: "T", where: "Hoh Xil, Qinghai", fact: "Saved from near-extinction", detail: "Spot herds grazing along the Qinghai–Tibet railway and highway through Hoh Xil, especially in the summer calving season (June–July)." },
  { name: "Red-crowned Crane", initial: "C", where: "NE China wetlands", fact: "Symbol of luck & longevity", detail: "Winter (Nov–Feb) is peak viewing at Yancheng and Zhalong reserves, where cranes gather in the hundreds — arrive at dawn to see their courtship dances." },
  { name: "Siberian Tiger", initial: "T", where: "NE China — Hunchun", fact: "Fewer than 60 in the wild", detail: "The rarest sight of all. Your best bet is the Hunchun Tiger–Leopard National Park in Jilin, or the breeding centers near Harbin." },
];

// ── Seasons ──
// ── Itineraries ──
const itineraries = [
  { days: "5 days", title: "Classic South", route: "Guilin → Yangshuo → Zhangjiajie", note: "Karst + pillar peaks. Easy to moderate, low altitude." },
  { days: "7 days", title: "West & Plateau", route: "Chengdu → Jiuzhaigou → Lhasa", note: "Lakes, pandas and the Roof of the World. Allow acclimatization." },
  { days: "10 days", title: "North & Wild", route: "Beijing → Dunhuang → Hulunbuir", note: "Desert, Silk Road and endless steppe. Best in summer–autumn." },
];

// ── Practical essentials ──
const practical = [
  { icon: "fa-passport", color: "#0f766e", title: "Visa", desc: "Around 40 countries get 30-day visa-free entry (the UK and Canada are in a 2026 trial); 57 qualify for 240-hour (10-day) visa-free transit — the US included. Otherwise an L visa costs $140 for 10-year multiple entry. Verify the latest list for your passport before booking." },
  { icon: "fa-ticket", color: "#14b8a6", title: "Tickets", desc: "Jiuzhaigou requires online reservation with a daily visitor cap — book days ahead. Zhangjiajie and Huangshan sell out in peak season. Most tickets are digital QR codes linked to your passport." },
  { icon: "fa-mountain-sun", color: "#d4a373", title: "Altitude", desc: "Above 3,000m, ascend gradually and acclimatize 1–2 nights before going higher. Hydrate, skip alcohol, and descend if headaches or breathlessness worsen." },
  { icon: "fa-credit-card", color: "#78716c", title: "Money & Payments", desc: "Alipay and WeChat Pay are everywhere; add an international card before you fly. Keep cash (small notes) as backup for rural areas, and tell your bank you're traveling." },
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "China Nature — Ultimate Guide to Natural Wonders & Parks",
  url: "https://www.chinanaturetrip.com/",
  description: "Discover China's nature — karst peaks, danxia cliffs, glaciers, deserts, lakes and wildlife. Find your perfect landscape with the trip finder, comparisons and itineraries.",
  inLanguage: "en",
};

const destinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  name: "China Nature",
  url: "https://www.chinanaturetrip.com/",
  description: "Independent guide to China's natural landscapes — karst, danxia, mountains, lakes, deserts, grasslands, glaciers, forests, wetlands and plateau. Find the right destination with the trip finder.",
  inLanguage: "en",
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "China's Top 10 Natural Wonders — Complete Guide to Nature, Parks & Wildlife in China",
  author: { "@type": "Person", name: "Alex Chen" },
  datePublished: "2026-08-19",
  dateModified: "2026-08-21",
  image: "https://www.chinanaturetrip.com/images/og.jpg",
  inLanguage: "en",
};

// ── Top 10 natural wonders (ranked list → ItemList schema) ──
const topWonders = [
  { name: "Zhangjiajie National Forest Park", img: "/images/mountains-zhangjiajie.webp", imgAlt: "Quartz-sandstone pillars of Zhangjiajie National Forest Park in Hunan, China", why: "3,000 quartz-sandstone pillars rising out of forest — the 'floating mountains' of Avatar and one of the most surreal landscapes on Earth.", bestFor: "First-timers who want drama", season: "Apr–Nov", location: "Hunan", unesco: true, ticket: "Forest park ~CNY 225 (4-day)", guideUrl: "https://zhangjiajie-national-park.com", wiki: "https://en.wikipedia.org/wiki/Zhangjiajie_National_Forest_Park" },
  { name: "Jiuzhaigou Valley", img: "/images/lakes-jiuzhaigou.webp", imgAlt: "Turquoise terraced lakes of Jiuzhaigou Valley in Sichuan, China", why: "Over 100 tiered lakes in every shade of turquoise, linked by waterfalls and snow peaks — the most photographed water in China.", bestFor: "Photographers & lake lovers", season: "Sep–Oct", location: "Sichuan", unesco: true, ticket: "~CNY 169–280; book online ahead", wiki: "https://en.wikipedia.org/wiki/Jiuzhaigou" },
  { name: "Zhangye Danxia Rainbow Mountains", img: "/images/danxia-zhangye.webp", imgAlt: "Rainbow-striped danxia cliffs of Zhangye in Gansu, China", why: "Striped red-sandstone ridges that look airbrushed — the colors peak just after sunrise and before sunset.", bestFor: "Photographers chasing color", season: "Year-round", location: "Gansu", unesco: true, ticket: "~CNY 75 + shuttle bus", wiki: "https://en.wikipedia.org/wiki/Zhangye_Danxia" },
  { name: "Guilin & Yangshuo Karst", img: "/images/karst-li-river.webp", imgAlt: "Karst peaks along the Li River in Guilin, China", why: "The postcard landscape of China — tower karst peaks above a lazy river, with the easiest logistics of any major natural sight.", bestFor: "First-timers & families", season: "Apr–Nov", location: "Guangxi", unesco: true, ticket: "Li River cruise ~CNY 360; parks from CNY 60", guideUrl: "https://guilin-yang-shuo.com", wiki: "https://en.wikipedia.org/wiki/Guilin" },
  { name: "Huangshan (Yellow Mountain)", img: "/images/mountains-huangshan.webp", imgAlt: "Granite peaks of Huangshan in Anhui, China", why: "The 'loveliest mountain of China' — granite spires, pines and a famous sea of clouds that inspired classical ink painting.", bestFor: "Hikers & sunrise chasers", season: "Year-round", location: "Anhui", unesco: true, ticket: "~CNY 190 + cable cars ~CNY 80–90", wiki: "https://en.wikipedia.org/wiki/Huangshan" },
  { name: "Crescent Lake & Mingsha Dunes", img: "/images/deserts-crescent-lake.webp", imgAlt: "Crescent Lake oasis in the Mingsha sand dunes of Dunhuang, China", why: "A crescent-shaped oasis lake held between singing sand dunes on the Silk Road — China's desert icon.", bestFor: "Desert lovers", season: "Apr–Jun, Sep–Oct", location: "Gansu", unesco: false, ticket: "Dunes ~CNY 110", guideUrl: "https://dunhuang-jiuquan.com", wiki: "https://en.wikipedia.org/wiki/Crescent_Lake_(Dunhuang)" },
  { name: "Tiger Leaping Gorge", img: "/images/plateau-tiger-leaping-gorge.webp", imgAlt: "The Jinsha River cutting through Tiger Leaping Gorge in Yunnan, China", why: "One of the deepest river canyons on Earth, carved between 5,000m snow peaks — with a world-class two-day hike.", bestFor: "Hikers", season: "Year-round", location: "Yunnan", unesco: true, ticket: "~CNY 45", guideUrl: "https://shangri-la-yunnan.com", wiki: "https://en.wikipedia.org/wiki/Tiger_Leaping_Gorge" },
  { name: "Hailuogou Glacier", img: "/images/glaciers-hailuogou.webp", imgAlt: "Ice fall and snow peaks of Hailuogou Glacier in Sichuan, China", why: "A rare low-altitude glacier with a 1,000m ice fall, reached by cable car and paired with natural hot springs.", bestFor: "Glacier fans without altitude legs", season: "Nov–Apr", location: "Sichuan", unesco: false, ticket: "~CNY 90 + cable car CNY 150", wiki: "https://en.wikipedia.org/wiki/Hailuogou" },
  { name: "Yunnan Stone Forest", img: "/images/karst-stone-forest.webp", imgAlt: "Limestone pinnacles of the Yunnan Stone Forest near Kunming, China", why: "A UNESCO-listed forest of 30m limestone pinnacles near Kunming — an easy day trip that feels like another planet.", bestFor: "Day-trippers from Kunming", season: "Year-round", location: "Yunnan", unesco: true, ticket: "~CNY 130", guideUrl: "https://yunnan-province.com", wiki: "https://en.wikipedia.org/wiki/Shilin_(Stone_Forest)" },
  { name: "Meili Snow Mountain", img: "/images/glaciers-meili.webp", imgAlt: "Kawagebo peak of Meili Snow Mountain at sunrise in Yunnan, China", why: "The sacred 6,740m peak whose 'sunrise on golden mountain' over Kawagebo is one of Tibet's greatest views.", bestFor: "Sunrise photographers", season: "Oct–Mar", location: "Yunnan", unesco: true, guideUrl: "https://shangri-la-yunnan.com", wiki: "https://en.wikipedia.org/wiki/Kawagarbo" },
];

const top10Schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Top 10 Natural Wonders in China",
  description: "The 10 best natural wonders and landscapes in China, ranked by a travel writer who has personally visited each one.",
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  numberOfItems: 10,
  itemListElement: topWonders.map((w, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: w.name,
    image: "https://www.chinanaturetrip.com" + w.img,
    url: "https://www.chinanaturetrip.com/#top-10",
    sameAs: w.wiki,
  })),
};

// ── Quick decision tree ──
const decisionTree = [
  { if: "Only 5 days and it's your first time", then: "Guilin & Yangshuo", why: "no altitude, easy logistics, the postcard scene" },
  { if: "You want drama and don't mind steps", then: "Zhangjiajie", why: "Avatar's floating peaks and a glass bridge" },
  { if: "You're a photographer chasing color", then: "Jiuzhaigou in autumn", why: "turquoise lakes at their peak" },
  { if: "You want snow and glaciers", then: "Hailuogou in winter", why: "a low-altitude glacier plus hot springs" },
  { if: "You love wildlife", then: "Chengdu pandas + Wolong", why: "the closest thing to wild pandas" },
  { if: "You fear altitude but want lakes", then: "Jiuzhaigou over Tibet", why: "same wow factor, far lower risk" },
];

// ── Traveler type cards ──
const travelerTypes = [
  { icon: "fa-plane", label: "First-timer", pick: "Guilin & Yangshuo", why: "The easiest intro to China's nature — no altitude, mature infrastructure, and the landscape you already know from photos.", days: "3–4 days" },
  { icon: "fa-camera", label: "Photographer", pick: "Jiuzhaigou + Zhangye Danxia", why: "The two most photogenic spots in China — mirror-still turquoise lakes and airbrushed rainbow cliffs.", days: "4–5 days" },
  { icon: "fa-person-hiking", label: "Hiker", pick: "Huangshan + Tiger Leaping Gorge", why: "Granite summit sunrises and Asia's most famous gorge trail — serious climbs with serious rewards.", days: "4–6 days" },
  { icon: "fa-people-group", label: "Family", pick: "Chengdu pandas + Guilin", why: "Pandas in the morning, bamboo rafts in the afternoon — low effort, high reward for kids.", days: "5–6 days" },
  { icon: "fa-binoculars", label: "Wildlife lover", pick: "Sichuan + Qinghai", why: "Pandas in Sichuan, then Tibetan antelope and snow-leopard country on the plateau.", days: "7–10 days" },
];

// ── Sister-site network (hub ↔ spoke) ──
const sisterSites = [
  { name: "Guilin & Yangshuo", url: "https://guilin-yang-shuo.com", tag: "Karst", desc: "Li River cruises, bamboo rafts and bike rides through rice paddies — the classic China postcard.", icon: "fa-mountain" },
  { name: "Zhangjiajie National Park", url: "https://zhangjiajie-national-park.com", tag: "Mountains", desc: "3,000 sandstone pillars that inspired Avatar — elevators, glass bridges and cloud forests.", icon: "fa-mountain" },
  { name: "Yunnan Province", url: "https://yunnan-province.com", tag: "Plateau & forests", desc: "Stone Forest, rice terraces, tropical Xishuangbanna and the Tibetan town of Shangri-La.", icon: "fa-earth-asia" },
  { name: "Shangri-La", url: "https://shangri-la-yunnan.com", tag: "Plateau", desc: "A Tibetan town at 3,200m — monasteries, alpine lakes and snow-capped gorges.", icon: "fa-snowflake" },
  { name: "Tibet & Lhasa", url: "https://tibet-lhasa-potala.com", tag: "Plateau", desc: "Potala Palace, turquoise sacred lakes and the Roof of the World.", icon: "fa-mountain-sun" },
  { name: "Dunhuang & Jiuquan", url: "https://dunhuang-jiuquan.com", tag: "Deserts", desc: "Singing sand dunes, the Crescent Lake oasis and the Silk Road's Mogao Caves.", icon: "fa-sun" },
  { name: "Dujiangyan Panda Base", url: "https://dujiangyan-panda-base.com", tag: "Wildlife", desc: "See giant pandas up close, with volunteer programs and forested enclosures.", icon: "fa-paw" },
];

// ── E-E-A-T author entity ──
const author = {
  name: "Alex Chen",
  role: "China travel writer & photographer",
  bio: "I've spent the last decade hiking, driving and photographing China's wild places — from the karst rivers of Guangxi to the glaciers of Sichuan. Every destination on this page is one I've personally visited, and the costs, seasons and routes reflect what I'd actually tell a friend. No sponsored listings, no tour-company scripts.",
};

---

<Layout preloadHero>
  <!-- 1. Hero -->
  <section id="top" class="relative flex min-h-[100dvh] items-center overflow-hidden">
    <img src="/images/hero-karst.webp" alt="China's dramatic karst mountains and rivers at golden hour" class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" width="1600" height="900" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-black/10"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-24">
      <div class="max-w-2xl">
        <span class="mb-6 inline-block rounded-full border border-white/30 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white">Independent Guide · No Tour Sales</span>
        <h1 class="font-display text-5xl font-bold tracking-tight text-white drop-shadow-md md:text-6xl lg:text-7xl lg:leading-[1.02]">China's Top 10 Natural&nbsp;Wonders</h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/90 drop-shadow">From Zhangjiajie's floating peaks to Jiuzhaigou's turquoise lakes — the 10 best nature places in China, ranked with seasons, costs and honest advice.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#trip-finder" class="rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[#0f766e]/20 transition-all hover:scale-105">Find My Trip</a>
          <a href="/landscapes/" class="rounded-full border border-white/40 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/20">Explore Landscapes</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Top 10 natural wonders -->
  <section id="top-10" class="relative bg-[#f8f7f4] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">The List</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Top 10 Natural Wonders in China</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Ranked by a writer who has personally visited every one of them — each pick is worth a dedicated trip.</p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href="#compare" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]">Compare the big three</a>
          <a href="/guides/#cheat-sheet" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]">All 12 destinations</a>
          <a href="#packing" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]">What to pack</a>
          <a href="#faq" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]">Quick answers</a>
        </div>
      </div>
      <div class="space-y-4">
        {topWonders.map((w, i) => (
          <article class="scroll-reveal group flex flex-col gap-4 rounded-2xl border border-[#d5d0c4]/40 bg-white p-5 shadow-sm transition-shadow hover:shadow-md md:flex-row md:items-center">
            <span class="font-display w-12 shrink-0 text-4xl font-bold text-[#0f766e]/20 md:text-5xl">{String(i + 1).padStart(2, "0")}</span>
            <img src={w.img} alt={w.imgAlt} class="h-40 w-full rounded-xl object-cover shadow-sm md:h-28 md:w-56 md:shrink-0" loading="lazy" />
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-bold text-[#1c1a16]">{w.name}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[#5c5a4c]">{w.why}</p>
              <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1.5">
                {w.unesco && (
                  <span class="inline-flex items-center gap-1 text-xs font-semibold text-[#b45309]"><Icon name="fa-award" class="text-[10px]" />UNESCO World Heritage</span>
                )}
                {w.ticket && (
                  <span class="inline-flex items-center gap-1 text-xs font-medium text-[#5c5a4c]"><Icon name="fa-ticket" class="text-[10px] text-[#14b8a6]" />{w.ticket}</span>
                )}
                {w.guideUrl && (
                  <a href={w.guideUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-xs font-semibold text-[#0f766e] transition-colors hover:text-[#115e59]">Full guide <Icon name="fa-arrow-up-right-from-square" class="text-[9px]" /></a>
                )}
              </div>
              <p class="mt-2 text-xs font-semibold text-[#14b8a6]">Best for: {w.bestFor}</p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-2 md:flex-col md:items-end">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#ccfbf1]/60 px-3 py-1 text-xs font-semibold text-[#0f766e]"><Icon name="fa-location-dot" class="text-[10px]" />{w.location}</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#edeae3] px-3 py-1 text-xs font-semibold text-[#5c5a4c]"><Icon name="fa-calendar" class="text-[10px]" />{w.season}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Start Here -->
  <section class="relative border-b border-[#d5d0c4] bg-white py-14">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-3xl border border-[#d5d0c4]/40 bg-gradient-to-br from-[#f0fdfa] to-white p-8 shadow-sm md:p-10">
        <div class="grid gap-8 lg:grid-cols-2">
          <div>
            <span class="tag tag-primary mb-4">Start Here</span>
            <h2 class="text-3xl font-bold tracking-tight text-[#1c1a16] md:text-4xl">First time in China for nature?</h2>
            <p class="mt-4 text-lg leading-relaxed text-[#5c5a4c]">Start with <strong class="text-[#0f766e]">Guilin & Yangshuo</strong> — 3–4 days, no altitude, and the exact landscape you've seen in every photo.</p>
            <a href="#trip-finder" class="mt-6 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3 text-sm font-semibold text-white shadow-md transition-all hover:scale-105">Find My Trip</a>
          </div>
          <div class="space-y-3">
            {decisionTree.map((d) => (
              <div class="flex items-start gap-3 rounded-xl border border-[#d5d0c4]/40 bg-white p-4 shadow-sm">
                <span class="mt-0.5 shrink-0 text-[#14b8a6]"><Icon name="fa-arrow-right" /></span>
                <p class="text-sm leading-relaxed text-[#5c5a4c]"><strong class="text-[#1c1a16]">{d.if}</strong> → {d.then} <span class="text-[#78716c]">({d.why})</span></p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Numbers -->
  <section class="relative border-b border-[#d5d0c4] bg-white/70 backdrop-blur-sm">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-6 py-12 md:grid-cols-4">
      <div class="scroll-reveal text-center"><p class="font-display text-4xl font-bold text-[#0f766e] md:text-5xl">14</p><p class="mt-1 text-sm text-[#5c5a4c]">World Natural Heritage sites</p></div>
      <div class="scroll-reveal text-center"><p class="font-display text-4xl font-bold text-[#0f766e] md:text-5xl">5</p><p class="mt-1 text-sm text-[#5c5a4c]">National parks (first batch)</p></div>
      <div class="scroll-reveal text-center"><p class="font-display text-4xl font-bold text-[#0f766e] md:text-5xl">49</p><p class="mt-1 text-sm text-[#5c5a4c]">National parks by 2035</p></div>
      <div class="scroll-reveal text-center"><p class="font-display text-4xl font-bold text-[#0f766e] md:text-5xl">11,800+</p><p class="mt-1 text-sm text-[#5c5a4c]">Protected areas</p></div>
    </div>
    <div class="mx-auto max-w-7xl px-6 pb-8">
      <p class="text-center text-xs text-[#5c5a4c]/70">Figures from <a href="https://whc.unesco.org/en/statesparties/cn" target="_blank" rel="noopener" class="underline hover:text-[#0f766e]">UNESCO World Heritage Centre</a> and China's National Forestry & Grassland Administration.</p>
    </div>
  </section>

  <!-- 3. Trip Finder -->
  <section id="trip-finder" class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">The Tool</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Find Your Landscape</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Filter by landform, season, difficulty and altitude — get a shortlist of destinations that actually fit your trip.</p>
      </div>
      <TripFinder destinations={destinations} />
    </div>
  </section>

  <!-- 3b. Traveler types -->
  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-warm mb-4">Who Are You?</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Your Type, Your Trip</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Different travelers need different landscapes. Pick your type and go.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {travelerTypes.map((t) => (
          <div class="card-playful scroll-reveal rounded-2xl border border-[#d5d0c4]/40 bg-white p-7 shadow-sm">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#ccfbf1]/60 text-[#0f766e]"><Icon name={t.icon} class="text-xl" /></div>
            <h3 class="text-lg font-bold text-[#1c1a16]">{t.label}</h3>
            <p class="mt-1 text-sm font-semibold text-[#0f766e]">Pick: {t.pick}</p>
            <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{t.why}</p>
            <p class="mt-3 inline-flex rounded-full bg-[#ccfbf1]/60 px-3 py-1 text-xs font-semibold text-[#0f766e]">{t.days}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

    <!-- 4. Landscapes matrix (teaser) -->
  <section id="landscapes" class="relative bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-warm mb-4">10 Landscapes</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Every Landscape China Has</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Karst peaks, rainbow danxia, glaciers, deserts and the high plateau — China has every major landform on Earth. Here are the ten, with the best place to see each.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/landscapes/#karst" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Karst</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Tower limestone peaks above jade rivers — Guilin & Yangshuo.</p></a>
        <a href="/landscapes/#danxia" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Danxia</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Rainbow-striped red cliffs — Zhangye's Rainbow Mountains.</p></a>
        <a href="/landscapes/#mountains" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Mountains</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Granite spires and cloud seas — Huangshan and Zhangjiajie.</p></a>
        <a href="/landscapes/#lakes" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Lakes</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Turquoise alpine water — Jiuzhaigou and Qinghai Lake.</p></a>
        <a href="/landscapes/#deserts" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Deserts</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Singing dunes and oases — Dunhuang's Crescent Lake.</p></a>
        <a href="/landscapes/#grasslands" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Grasslands</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Endless steppe and yurts — Hulunbuir in summer.</p></a>
        <a href="/landscapes/#glaciers" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Glaciers</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Low-altitude ice falls — Hailuogou above Mount Gongga.</p></a>
        <a href="/landscapes/#forests" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Forests</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Primeval woodland and rainforest — Shennongjia, Xishuangbanna.</p></a>
        <a href="/landscapes/#wetlands" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Wetlands</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">Bird sanctuaries and peat bogs — the Yellow River Delta.</p></a>
        <a href="/landscapes/#plateau" class="card-playful group rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm"><h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Plateau</h3><p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">The Roof of the World — Tibet, Shangri-La and the high passes.</p></a>
      </div>
      <div class="mt-8 text-center">
        <a href="/landscapes/" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3 text-sm font-semibold text-white shadow-md transition-all hover:scale-105">Explore all 10 landscapes</a>
      </div>
    </div>
  </section>

<!-- 5. Compare -->
  <section id="compare" class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-stone mb-4">The Big Three</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Zhangjiajie vs Guilin vs Jiuzhaigou</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">The question everyone asks. Here's the honest answer.</p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-[#d5d0c4]/40 bg-white shadow-sm">
        <table class="w-full min-w-[640px] border-collapse text-sm">
          <thead>
            <tr class="bg-[#0f766e] text-left text-white">
              <th class="px-5 py-4 font-semibold"></th>
              {comparison.columns.map((c) => <th class="px-5 py-4 font-semibold">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {comparison.rows.map((row) => (
              <tr class="border-t border-[#d5d0c4]/40">
                <td class="px-5 py-4 font-semibold text-[#0f766e]">{row.label}</td>
                {row.values.map((v) => <td class="px-5 py-4 text-[#5c5a4c]">{v}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <details class="qa mt-6 rounded-2xl border border-[#d5d0c4]/40 bg-white shadow-sm">
        <summary class="flex cursor-pointer items-center justify-between p-5">
          <span class="text-lg font-bold text-[#0f766e]">More comparisons</span>
          <svg class="qa-chevron h-5 w-5 text-[#14b8a6]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        </summary>
        <div class="space-y-4 px-5 pb-5">
          <div class="rounded-xl bg-[#f8f7f4] p-4">
            <p class="font-semibold text-[#1c1a16]">Guilin vs Yunnan</p>
            <p class="mt-1 text-sm leading-relaxed text-[#5c5a4c]">Guilin is one compact region — perfect for a 3–4 day trip. Yunnan is a whole province — expect a week or more and bigger distances. Pick Guilin for ease; Yunnan for variety (Stone Forest, rice terraces, Shangri-La).</p>
          </div>
          <div class="rounded-xl bg-[#f8f7f4] p-4">
            <p class="font-semibold text-[#1c1a16]">Jiuzhaigou vs Huanglong</p>
            <p class="mt-1 text-sm leading-relaxed text-[#5c5a4c]">Both are Sichuan valleys, often combined in one trip. Jiuzhaigou is bigger, bluer and more famous; Huanglong is a smaller travertine terrace with a gentler walk. Do both in 3 days from Chengdu.</p>
          </div>
          <div class="rounded-xl bg-[#f8f7f4] p-4">
            <p class="font-semibold text-[#1c1a16]">Huangshan vs Zhangjiajie</p>
            <p class="mt-1 text-sm leading-relaxed text-[#5c5a4c]">Huangshan is classic granite scenery — pines, cloud seas and a famous sunrise. Zhangjiajie is alien sandstone pillars and adventure attractions. Pick Huangshan for atmosphere, Zhangjiajie for drama.</p>
          </div>
        </div>
      </details>
    </div>
  </section>

    <!-- 6. Seasons (teaser) -->
  <section class="relative bg-[#0f766e] py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-6 text-center">
      <span class="mb-4 inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">Timing</span>
      <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">When to Go — and What It Costs</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">Spring and autumn are the sweet spots, but every season has a landscape. Budgets run $30–50/day budget to $1,200+ for comfort.</p>
      <a href="/guides/#seasons" class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-[#0f766e] shadow-md transition-all hover:scale-105">Read the season &amp; budget guide</a>
    </div>
  </section>

<!-- 7. Wildlife -->
  <section id="wildlife" class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">Wildlife</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">The Animals You Came For</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Pandas are the headline — but China hides snow leopards, monkeys and cranes too.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {wildlife.map((w) => (
          <div class="card-playful scroll-reveal flex items-start gap-4 rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm">
            {w.img ? (
              <img src={w.img} alt={w.imgAlt} class="h-16 w-16 shrink-0 rounded-2xl object-cover shadow-sm" loading="lazy" />
            ) : (
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-lg font-bold text-white">{w.initial}</span>
            )}
            <div>
              <h3 class="text-lg font-bold text-[#1c1a16]">{w.name}</h3>
              <p class="mt-1 text-sm text-[#5c5a4c]">{w.where}</p>
              <p class="mt-2 inline-flex rounded-full bg-[#ccfbf1]/60 px-3 py-1 text-xs font-semibold text-[#0f766e]">{w.fact}</p>
              <p class="mt-3 text-sm leading-relaxed text-[#5c5a4c]">{w.detail}</p>
              {w.url && (
                <a href={w.url} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-[#0f766e] transition-colors hover:text-[#115e59]">
                  See pandas up close <Icon name="fa-arrow-up-right-from-square" class="text-[11px]" />
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Itineraries -->
  <section id="itineraries" class="relative bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-warm mb-4">Routes</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Three Ways to Do It</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Copy-paste itineraries — ready-made routes that combine regions sensibly.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {itineraries.map((it, i) => (
          <div class="card-playful scroll-reveal rounded-2xl border border-[#d5d0c4]/40 bg-white p-8 shadow-sm">
            <div class={`step-circle step-circle-${i + 1} mb-5`}>{i + 1}</div>
            <p class="text-xs font-bold uppercase tracking-wider text-[#14b8a6]">{it.days}</p>
            <h3 class="mt-1 text-2xl font-bold text-[#1c1a16]">{it.title}</h3>
            <p class="mt-2 text-sm font-medium text-[#0f766e]">{it.route}</p>
            <p class="mt-3 text-sm leading-relaxed text-[#5c5a4c]">{it.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Practical -->
  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-stone mb-4">Before You Fly</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">The Practical Stuff</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Four things that stress people out — solved.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {practical.map((p) => (
          <div class="scroll-reveal rounded-2xl border border-[#d5d0c4]/40 bg-white p-7 shadow-sm">
            <Icon name={p.icon} class="text-2xl" style={`color: ${p.color}`} />
            <h3 class="mt-3 text-lg font-bold text-[#1c1a16]">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. FAQ teaser -->
  <section id="faq" class="relative py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <span class="tag tag-primary mb-4 inline-block">Quick Answers</span>
      <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Frequently Asked Questions</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-[#5c5a4c]">Visas, seasons, park tickets, altitude, packing and costs — the 21 questions travelers actually ask, answered firsthand.</p>
      <div class="mx-auto mt-8 grid max-w-3xl gap-3 text-left sm:grid-cols-2">
        <a href="/faq/" class="rounded-xl border border-[#d5d0c4]/40 bg-white px-5 py-3 text-sm font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]/50 hover:bg-[#f8f7f4]">Do I need a visa to visit China?</a>
        <a href="/faq/" class="rounded-xl border border-[#d5d0c4]/40 bg-white px-5 py-3 text-sm font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]/50 hover:bg-[#f8f7f4]">What is the best time of year to visit?</a>
        <a href="/faq/" class="rounded-xl border border-[#d5d0c4]/40 bg-white px-5 py-3 text-sm font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]/50 hover:bg-[#f8f7f4]">How many days do I need per destination?</a>
        <a href="/faq/" class="rounded-xl border border-[#d5d0c4]/40 bg-white px-5 py-3 text-sm font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]/50 hover:bg-[#f8f7f4]">How much does a nature trip in China cost?</a>
      </div>
      <a href="/faq/" class="mt-8 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3 text-sm font-semibold text-white shadow-md transition-all hover:scale-105">Read all 21 answers</a>
    </div>
  </section>

  <!-- 11. Sources & citations -->
  <section id="sources" class="relative border-t border-[#d5d0c4] bg-white py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-10 text-center">
        <span class="tag tag-primary mb-4 inline-block">Sources</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Sources &amp; Further Reading</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-[#5c5a4c]">Authoritative references behind the facts on this page — UNESCO designations, protected-area figures and landscape science.</p>
      </div>
      <blockquote class="mb-10 rounded-r-2xl border-l-4 border-[#14b8a6]/60 bg-[#f8f7f4] py-5 pl-6 pr-4 text-sm italic leading-relaxed text-[#5c5a4c]">
        <p>"A spectacular area stretching over 26,000 ha in China's Hunan Province, the site is dominated by more than 3,000 narrow sandstone pillars and peaks, many over 200 m high. Between the pillars lie ravines and gorges with streams, pools and waterfalls."</p>
        <footer class="mt-3 text-xs font-semibold not-italic text-[#0f766e]">— <cite><a href="https://whc.unesco.org/en/list/640" target="_blank" rel="noopener" class="underline hover:no-underline">UNESCO World Heritage Centre, Wulingyuan Scenic Area</a></cite></footer>
      </blockquote>
      <div class="flex flex-wrap justify-center gap-2">
        {[
          { name: "UNESCO — China", url: "https://whc.unesco.org/en/statesparties/cn" },
          { name: "Zhangjiajie (Wulingyuan)", url: "https://en.wikipedia.org/wiki/Wulingyuan" },
          { name: "Jiuzhaigou", url: "https://en.wikipedia.org/wiki/Jiuzhaigou" },
          { name: "Zhangye Danxia", url: "https://en.wikipedia.org/wiki/Zhangye_Danxia" },
          { name: "Guilin", url: "https://en.wikipedia.org/wiki/Guilin" },
          { name: "Huangshan", url: "https://en.wikipedia.org/wiki/Huangshan" },
          { name: "Crescent Lake", url: "https://en.wikipedia.org/wiki/Crescent_Lake_(Dunhuang)" },
          { name: "Tiger Leaping Gorge", url: "https://en.wikipedia.org/wiki/Tiger_Leaping_Gorge" },
          { name: "Hailuogou", url: "https://en.wikipedia.org/wiki/Hailuogou" },
          { name: "Stone Forest", url: "https://en.wikipedia.org/wiki/Shilin_(Stone_Forest)" },
          { name: "Kawagarbo (Meili)", url: "https://en.wikipedia.org/wiki/Kawagarbo" },
          { name: "China National Parks", url: "https://en.wikipedia.org/wiki/List_of_national_parks_of_China" },
        ].map((s) => (
          <a href={s.url} target="_blank" rel="noopener" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-medium text-[#5c5a4c] transition-colors hover:border-[#14b8a6]/50 hover:text-[#0f766e]">{s.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- 11b. Sister-site network -->
  <section id="guides" class="relative border-t border-[#d5d0c4] bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">Go Deeper</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Explore Our Destination Guides</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">In-depth, independent guides to the places above — written the same honest way, with no tour sales.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sisterSites.map((site) => (
          <a href={site.url} target="_blank" rel="noopener" class="card-playful scroll-reveal group flex flex-col rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#ccfbf1]/60 text-[#0f766e]"><Icon name={site.icon} class="text-xl" /></div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#14b8a6]">{site.tag}</span>
            <h3 class="mt-2 text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">{site.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{site.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#0f766e]">Read guide <Icon name="fa-arrow-right" class="text-xs transition-transform group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. Author -->
  <section class="relative border-t border-[#d5d0c4] bg-[#edeae3] py-16">
    <div class="mx-auto max-w-4xl px-6">
      <div class="flex flex-col items-center gap-6 rounded-3xl border border-[#d5d0c4]/40 bg-white p-8 text-center shadow-sm md:flex-row md:text-left">
        <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-2xl font-bold text-white">{author.name.charAt(0)}</span>
        <div>
          <p class="text-lg font-bold text-[#1c1a16]">{author.name}</p>
          <p class="text-sm font-semibold text-[#0f766e]">{author.role}</p>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#5c5a4c]">{author.bio}</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(top10Schema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(destinationSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
</Layout>
