        ].map((s) => (
          <a href={s.url} target="_blank" rel="noopener" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-medium text-[#5c5a4c] transition-colors hover:border-[#14b8a6]/50 hover:text-[#0f766e]">{s.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- 11b. Sister-site network -->
  <section id="guides" class="relative border-t border-[#d5d0c4] bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">Go Deeper</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Explore Our Destination Guides</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">In-depth, independent guides to the places above — written the same honest way, with no tour sales.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sisterSites.map((site) => (
          <a href={site.url} target="_blank" rel="noopener" class="card-playful scroll-reveal group flex flex-col rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#ccfbf1]/60 text-[#0f766e]"><Icon name={site.icon} class="text-xl" /></div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#14b8a6]">{site.tag}</span>
            <h3 class="mt-2 text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">{site.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{site.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#0f766e]">Read guide <Icon name="fa-arrow-right" class="text-xs transition-transform group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. Author -->
  <section class="relative border-t border-[#d5d0c4] bg-[#edeae3] py-16">
    <div class="mx-auto max-w-4xl px-6">
      <div class="flex flex-col items-center gap-6 rounded-3xl border border-[#d5d0c4]/40 bg-white p-8 text-center shadow-sm md:flex-row md:text-left">
        <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-2xl font-bold text-white">{author.name.charAt(0)}</span>
        <div>
          <p class="text-lg font-bold text-[#1c1a16]">{author.name}</p>
          <p class="text-sm font-semibold text-[#0f766e]">{author.role}</p>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#5c5a4c]">{author.bio}</p>
        </div>
      </div>
    </div>
  </section>

