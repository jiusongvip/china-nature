  { name: "Yunnan Stone Forest", img: "/images/karst-stone-forest.webp", imgAlt: "Limestone pinnacles of the Yunnan Stone Forest near Kunming, China", why: "A UNESCO-listed forest of 30m limestone pinnacles near Kunming — an easy day trip that feels like another planet.", bestFor: "Day-trippers from Kunming", season: "Year-round", location: "Yunnan", unesco: true, ticket: "~CNY 130", guideUrl: "https://yunnan-province.com", wiki: "https://en.wikipedia.org/wiki/Shilin_(Stone_Forest)" },
  { name: "Meili Snow Mountain", img: "/images/glaciers-meili.webp", imgAlt: "Kawagebo peak of Meili Snow Mountain at sunrise in Yunnan, China", why: "The sacred 6,740m peak whose 'sunrise on golden mountain' over Kawagebo is one of Tibet's greatest views.", bestFor: "Sunrise photographers", season: "Oct–Mar", location: "Yunnan", unesco: true, guideUrl: "https://shangri-la-yunnan.com", wiki: "https://en.wikipedia.org/wiki/Kawagarbo" },
