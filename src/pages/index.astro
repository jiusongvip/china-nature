  { name: "Huangshan (Yellow Mountain)", img: "/images/mountains-huangshan.webp", imgAlt: "Granite peaks of Huangshan in Anhui, China", why: "The 'loveliest mountain of China' — granite spires, pines and a famous sea of clouds that inspired classical ink painting.", bestFor: "Hikers & sunrise chasers", season: "Year-round", location: "Anhui", unesco: true, ticket: "~CNY 190 + cable cars ~CNY 80–90", wiki: "https://en.wikipedia.org/wiki/Huangshan" },
  { name: "Crescent Lake & Mingsha Dunes", img: "/images/deserts-crescent-lake.webp", imgAlt: "Crescent Lake oasis in the Mingsha sand dunes of Dunhuang, China", why: "A crescent-shaped oasis lake held between singing sand dunes on the Silk Road — China's desert icon.", bestFor: "Desert lovers", season: "Apr–Jun, Sep–Oct", location: "Gansu", unesco: false, ticket: "Dunes ~CNY 110", guideUrl: "https://dunhuang-jiuquan.com", wiki: "https://en.wikipedia.org/wiki/Crescent_Lake_(Dunhuang)" },
