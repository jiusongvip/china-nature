const top10Schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Top 10 Natural Wonders in China",
  description: "The 10 best natural wonders and landscapes in China, ranked by a travel writer who has personally visited each one.",
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  numberOfItems: 10,
  itemListElement: topWonders.map((w, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: w.name,
    image: "https://www.chinanaturetrip.com" + w.img,
    url: "https://www.chinanaturetrip.com/#top-10",
    sameAs: w.wiki,
  })),
};

// ── Quick decision tree ──
const decisionTree = [
  { if: "Only 5 days and it's your first time", then: "Guilin & Yangshuo", why: "no altitude, easy logistics, the postcard scene" },
