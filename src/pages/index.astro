  { region: "Chengdu & Jiuzhaigou (Sichuan)", dishes: "Hotpot, mapo tofu, dan dan noodles; Tibetan yak dishes in Jiuzhaigou", note: "In Jiuzhaigou, meals are mostly at your hotel or Tibetan family restaurants — simpler and pricier than Chengdu's famous cheap eats." },
  { region: "Dunhuang (Gansu)", dishes: "Donkey-meat yellow noodles, lamb soup, Lanzhou beef noodles", note: "Silk Road flavours — lamb and noodles dominate. The Shazhou night market is where to eat after the dunes." },
  { region: "Yunnan — Xishuangbanna, Shangri-La, Kunming", dishes: "Crossing-the-bridge noodles, Dai-style grilled fish, pineapple rice, yak butter tea", note: "China's most diverse food province — Dai food in the tropical south, Tibetan food in the northern mountains." },
  { region: "Tibet — Lhasa", dishes: "Tsampa (roasted barley), yak momo dumplings, sweet tea, yak butter tea", note: "Tibetan food is hearty and high-calorie — ideal at altitude. Sweet tea houses are the local social hub." },
  { region: "Inner Mongolia — Hulunbuir", dishes: "Hand-grabbed mutton, milk tea, dairy snacks, roasted whole lamb", note: "Eat like a herder — mutton, dairy and tea. Yurt camps usually cook for guests, so meals are often included." },
];

const diningTips = [
  { title: "Dietary restrictions", tip: "Vegetarian: say 'wǒ chī sù' (I eat vegetarian). Halal food is widely available in the northwest (Gansu, Xinjiang). Print a card with your allergies in Chinese characters." },
  { title: "Ordering without Chinese", tip: "Point at photos on the menu, use a translation app's camera, or ask for the English menu at tourist restaurants. Most picture menus are self-explanatory." },
  { title: "Street-food safety", tip: "Stick to busy stalls with high turnover. Bottled water is cheap everywhere; do not drink tap water." },
  { title: "Tipping", tip: "Tipping is not expected anywhere in China — not in restaurants, taxis or hotels. Round up a taxi fare at most." },
];

// ── Where to stay ──
const whereToStay = [
  { place: "Guilin & Yangshuo", best: "Yangshuo town or a riverside village on the Yulong River", why: "Guilin city is the transport hub, but Yangshuo is where the scenery is — wake up to karst peaks. Riverside guesthouses just outside town are quieter than West Street.", price: "Guesthouses CNY 150–400; riverside boutique CNY 400–800" },
  { place: "Zhangjiajie", best: "Wulingyuan town, by the park's east gate", why: "Staying in Zhangjiajie city adds a 40-minute shuttle each way. Wulingyuan puts you at the gate for an early start and shorter elevator queues.", price: "Hotels CNY 200–600" },
  { place: "Jiuzhaigou", best: "Zhangzha town, at the park entrance", why: "There is no lodging inside the park itself. Zhangzha village is a short walk from the gate — book early in autumn, it sells out.", price: "Hotels CNY 250–800 (pricier in October)" },
  { place: "Huangshan", best: "One night on the summit (Beihai or Paiyunlou hotel)", why: "The famous sunrise is only practical if you sleep on top. Summit hotels are small and sell out weeks ahead.", price: "Summit CNY 900–1,500; base town CNY 150–300" },
  { place: "Dunhuang", best: "Shazhou town centre", why: "Compact and walkable, next to the night market and a short taxi from the dunes and the Mogao booking office.", price: "Hotels CNY 150–400" },
  { place: "Shangri-La & Tibet", best: "Shangri-La old town or Lhasa's Barkhor area", why: "Stay central for acclimatization — you will want to walk less on day one. Ask for a room with oxygen supply at high-altitude hotels.", price: "CNY 200–600; Lhasa mid-range CNY 300–700" },
];

const bookingTips = [
  { title: "Which platform", tip: "Trip.com and Ctrip have the best English interface and accept foreign cards. Booking.com and Agoda also work. For guesthouses and homestays, Trip.com has the widest rural coverage." },
  { title: "Passport registration", tip: "Every hotel legally registers your passport at check-in — this is normal and required. Have your physical passport (not a copy) ready." },
  { title: "Peak-season booking", tip: "Book 1–2 months ahead for October (Golden Week), Chinese New Year and July–August. Jiuzhaigou and Huangshan summit hotels sell out earliest." },
  { title: "Altitude choice", tip: "Above 3,000m, pick a hotel with an elevator and oxygen, and sleep low on night one — stay in Chengdu or Kunming before going straight to Lhasa." },
];

// ── Getting around ──
const transportModes = [
  { mode: "High-speed rail", best: "Most journeys between cities", detail: "Fastest, cheapest, most reliable. Guilin, Zhangjiajie, Huangshan and Chengdu all have stations. Book on Trip.com or 12306 up to 15 days ahead; seats release at about 8am Beijing time.", tip: "Book 15 days out in peak season — popular routes sell out." },
  { mode: "Domestic flights", best: "Remote parks — Jiuzhaigou, Shangri-La, Kanas", detail: "Often cheaper than expected and the only sane way to reach far-flung destinations. Fly from the Chengdu, Kunming or Xi'an hubs.", tip: "Allow buffer time — mountain airports can be fogged in." },
  { mode: "Private car with driver", best: "Dunhuang, grasslands, multi-stop loops", detail: "Hiring a car with driver (CNY 500–900/day) is the easiest way to cover spread-out scenery. Book through your hotel or a licensed agency; self-driving requires a Chinese licence.", tip: "Agree the full route and price in writing before setting off." },
  { mode: "Buses & park shuttles", best: "Inside parks and last-mile links", detail: "Every big park has mandatory shuttle buses (Jiuzhaigou, Zhangjiajie). Long-distance coaches connect small towns cheaply but slowly.", tip: "Park shuttles are usually included in, or added to, your ticket." },
];

const gettingAroundTips = [
  { title: "Buying train tickets", tip: "Trip.com (English) or the official 12306 app (Chinese). Tickets go on sale 15 days ahead at 8am Beijing time. Scan your passport directly at station e-gates." },
  { title: "Ride-hailing & taxis", tip: "Didi is China's Uber — set it up with a foreign card before you fly. Taxis are cheap but drivers rarely speak English; show the address in Chinese characters." },
  { title: "Navigation apps", tip: "Google Maps is unreliable inside China. Use Apple Maps (works well), Amap/Gaode or Baidu Maps, and download offline maps before you go." },
  { title: "Inside the parks", tip: "Buy shuttle + cable-car combos — distances are huge. Arrive at opening time (6–7am) to beat queues, and note the last shuttle time so you don't get stranded." },
];

// ── Mistakes to avoid ──
const mistakes = [
  { mistake: "Underestimating distances", fix: "China is the size of a continent. Zhangjiajie and Guilin are 600km apart — don't try to 'pop over'. Plan half a day of travel between any two stops." },
  { mistake: "Going during Golden Week (Oct 1–7)", fix: "The entire country travels at once. Parks hit capacity, prices triple and viewpoints are shoulder-to-shoulder. Shift your trip by one week and it all disappears." },
  { mistake: "Not booking tickets in advance", fix: "Jiuzhaigou caps daily visitors and sells out; Huangshan summit hotels and Mogao Caves slots go weeks ahead. Book the moment your dates are fixed." },
  { mistake: "Rushing altitude", fix: "Flying straight from sea level to Lhasa is how people ruin their trip. Acclimatize 1–2 nights in Chengdu, Kunming or Xining first, and take it slow on day one above 3,000m." },
  { mistake: "Packing only for heat", fix: "Even in summer, mountain mornings and desert nights are cold. Layers beat a single heavy coat, and a rain jacket is non-negotiable in the south." },
  { mistake: "Skipping the eSIM / VPN setup", fix: "Google, WhatsApp and Instagram are blocked inside China. Set up a travel eSIM or roaming plan and any VPN before you fly — not at the airport." },
  { mistake: "Trusting the first 'official' ticket seller", fix: "Touts outside stations and parks sell overpriced or fake tickets. Buy from the official app, your hotel, or the park's own ticket office." },
  { mistake: "Eating at the attraction entrance", fix: "Food right at the gate is the worst value. Walk 10 minutes into town or ask your hotel where locals eat — same dish, half the price." },
  { mistake: "Arriving late to the park", fix: "Cable-car and shuttle queues peak from 10am. Arrive at opening (6–7am) and you'll have the viewpoint nearly to yourself for an hour." },
  { mistake: "Forgetting your passport", fix: "Parks, trains and hotels all require your physical passport. A photo or copy is usually not enough — carry the real thing every day." },
];

// ── Photography ──
const photography = [
  { spot: "Zhangye Danxia", tip: "Shoot at golden hour — the striped cliffs look flat under midday sun. The west gate has shorter lines; viewpoint No.4 is the classic frame." },
  { spot: "Jiuzhaigou", tip: "Go in late October, enter at 7am, and head to Five-Flower Lake before the wind picks up — still water gives the mirror reflection." },
  { spot: "Huangshan", tip: "Stay on the summit and shoot the cloud sea at dawn. A polarizer cuts glare off the granite and deepens the sky." },
  { spot: "Guilin & Yangshuo", tip: "The classic shot is from Xianggong Hill at sunrise, looking down the Li River bend. On the river, shoot from the front of the raft." },
  { spot: "Dunhuang", tip: "Climb the dunes for sunset over Crescent Lake; a telephoto compresses the dune ridges. Protect your camera from sand — it gets everywhere." },
  { spot: "Tibet & Shangri-La", tip: "The 'golden mountain' sunrise on Meili Snow Mountain is a once-in-a-lifetime frame — go Oct–Mar for clear skies. Ask before photographing monks." },
];

// ── Step-by-step planning (HowTo) ──
const planSteps = [
  { step: "Pick your season", detail: "Spring (Mar–May) and autumn (Sep–Nov) suit most of China. Choose your window, then work backwards." },
  { step: "Choose 1–2 regions", detail: "Don't try to see everything. Pick one landscape (e.g. karst) or one region (e.g. Sichuan), and anchor your trip there." },
  { step: "Lock the big tickets first", detail: "Book national-park tickets, summit hotels and any flights before anything else — they sell out first." },
  { step: "Book trains and hotels", detail: "Trains open 15 days ahead at 8am Beijing time. Book hotels next to the park gate for early starts." },
  { step: "Sort your visa and phone", detail: "Check visa / visa-free status, set up Alipay & WeChat Pay, buy a travel eSIM and install a VPN before you fly." },
  { step: "Pack for the landscape", detail: "Layers, walking shoes, rain jacket, sunscreen and a power bank cover 90% of scenarios." },
];

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Plan a China Nature Trip",
  description: "Six steps to plan a nature trip in China — from choosing your season to packing.",
  step: planSteps.map((s, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: s.step,
    text: s.detail,
  })),
};

// ── E-E-A-T author entity ──
const author = {
  name: "Alex Chen",
  role: "China travel writer & photographer",
  bio: "I've spent the last decade hiking, driving and photographing China's wild places — from the karst rivers of Guangxi to the glaciers of Sichuan. Every destination on this page is one I've personally visited, and the costs, seasons and routes reflect what I'd actually tell a friend. No sponsored listings, no tour-company scripts.",
};

---

<Layout>
  <!-- 1. Hero -->
  <section id="top" class="relative flex min-h-[100dvh] items-center overflow-hidden">
    <img src="/images/hero-karst.webp" alt="China's dramatic karst mountains and rivers at golden hour" class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" width="1600" height="900" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-black/10"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-24">
      <div class="max-w-2xl">
        <span class="mb-6 inline-block rounded-full border border-white/30 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white">Independent Guide · No Tour Sales</span>
        <h1 class="font-display text-5xl font-bold tracking-tight text-white drop-shadow-md md:text-6xl lg:text-7xl lg:leading-[1.02]">China's Top 10 Natural&nbsp;Wonders</h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/90 drop-shadow">From Zhangjiajie's floating peaks to Jiuzhaigou's turquoise lakes — the 10 best nature places in China, ranked with seasons, costs and honest advice.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#trip-finder" class="rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[#0f766e]/20 transition-all hover:scale-105">Find My Trip</a>
          <a href="#landscapes" class="rounded-full border border-white/40 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/20">Explore Landscapes</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Top 10 natural wonders -->
  <section id="top-10" class="relative bg-[#f8f7f4] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">The List</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Top 10 Natural Wonders in China</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Ranked by a writer who has personally visited every one of them — each pick is worth a dedicated trip.</p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href="#compare" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]">Compare the big three</a>
          <a href="#cheat-sheet" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]">All 12 destinations</a>
          <a href="#packing" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]">What to pack</a>
          <a href="#faq" class="rounded-full border border-[#d5d0c4] bg-white px-4 py-1.5 text-xs font-semibold text-[#0f766e] transition-colors hover:border-[#14b8a6]">Quick answers</a>
        </div>
      </div>
      <div class="space-y-4">
        {topWonders.map((w, i) => (
          <article class="scroll-reveal group flex flex-col gap-4 rounded-2xl border border-[#d5d0c4]/40 bg-white p-5 shadow-sm transition-shadow hover:shadow-md md:flex-row md:items-center">
            <span class="font-display w-12 shrink-0 text-4xl font-bold text-[#0f766e]/20 md:text-5xl">{String(i + 1).padStart(2, "0")}</span>
            <img src={w.img} alt={w.imgAlt} class="h-40 w-full rounded-xl object-cover shadow-sm md:h-28 md:w-56 md:shrink-0" loading="lazy" />
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-bold text-[#1c1a16]">{w.name}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[#5c5a4c]">{w.why}</p>
              <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1.5">
                {w.unesco && (
                  <span class="inline-flex items-center gap-1 text-xs font-semibold text-[#b45309]"><i class="fa-solid fa-award text-[10px]"></i>UNESCO World Heritage</span>
                )}
                {w.ticket && (
                  <span class="inline-flex items-center gap-1 text-xs font-medium text-[#5c5a4c]"><i class="fa-solid fa-ticket text-[10px] text-[#14b8a6]"></i>{w.ticket}</span>
                )}
                {w.guideUrl && (
                  <a href={w.guideUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-xs font-semibold text-[#0f766e] transition-colors hover:text-[#115e59]">Full guide <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i></a>
                )}
              </div>
              <p class="mt-2 text-xs font-semibold text-[#14b8a6]">Best for: {w.bestFor}</p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-2 md:flex-col md:items-end">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#ccfbf1]/60 px-3 py-1 text-xs font-semibold text-[#0f766e]"><i class="fa-solid fa-location-dot text-[10px]"></i>{w.location}</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#edeae3] px-3 py-1 text-xs font-semibold text-[#5c5a4c]"><i class="fa-regular fa-calendar text-[10px]"></i>{w.season}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Start Here -->
  <section class="relative border-b border-[#d5d0c4] bg-white py-14">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-3xl border border-[#d5d0c4]/40 bg-gradient-to-br from-[#f0fdfa] to-white p-8 shadow-sm md:p-10">
        <div class="grid gap-8 lg:grid-cols-2">
          <div>
            <span class="tag tag-primary mb-4">Start Here</span>
            <h2 class="text-3xl font-bold tracking-tight text-[#1c1a16] md:text-4xl">First time in China for nature?</h2>
            <p class="mt-4 text-lg leading-relaxed text-[#5c5a4c]">Start with <strong class="text-[#0f766e]">Guilin & Yangshuo</strong> — 3–4 days, no altitude, and the exact landscape you've seen in every photo.</p>
            <a href="#trip-finder" class="mt-6 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3 text-sm font-semibold text-white shadow-md transition-all hover:scale-105">Find My Trip</a>
          </div>
          <div class="space-y-3">
            {decisionTree.map((d) => (
              <div class="flex items-start gap-3 rounded-xl border border-[#d5d0c4]/40 bg-white p-4 shadow-sm">
                <span class="mt-0.5 shrink-0 text-[#14b8a6]"><i class="fa-solid fa-arrow-right"></i></span>
                <p class="text-sm leading-relaxed text-[#5c5a4c]"><strong class="text-[#1c1a16]">{d.if}</strong> → {d.then} <span class="text-[#78716c]">({d.why})</span></p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Numbers -->
  <section class="relative border-b border-[#d5d0c4] bg-white/70 backdrop-blur-sm">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-6 py-12 md:grid-cols-4">
      <div class="scroll-reveal text-center"><p class="font-display text-4xl font-bold text-[#0f766e] md:text-5xl">14</p><p class="mt-1 text-sm text-[#5c5a4c]">World Natural Heritage sites</p></div>
      <div class="scroll-reveal text-center"><p class="font-display text-4xl font-bold text-[#0f766e] md:text-5xl">5</p><p class="mt-1 text-sm text-[#5c5a4c]">National parks (first batch)</p></div>
      <div class="scroll-reveal text-center"><p class="font-display text-4xl font-bold text-[#0f766e] md:text-5xl">49</p><p class="mt-1 text-sm text-[#5c5a4c]">National parks by 2035</p></div>
      <div class="scroll-reveal text-center"><p class="font-display text-4xl font-bold text-[#0f766e] md:text-5xl">11,800+</p><p class="mt-1 text-sm text-[#5c5a4c]">Protected areas</p></div>
    </div>
    <div class="mx-auto max-w-7xl px-6 pb-8">
      <p class="text-center text-xs text-[#5c5a4c]/70">Figures from <a href="https://whc.unesco.org/en/statesparties/cn" target="_blank" rel="noopener" class="underline hover:text-[#0f766e]">UNESCO World Heritage Centre</a> and China's National Forestry & Grassland Administration.</p>
    </div>
  </section>

  <!-- 3. Trip Finder -->
  <section id="trip-finder" class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-primary mb-4">The Tool</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Find Your Landscape</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Filter by landform, season, difficulty and altitude — get a shortlist of destinations that actually fit your trip.</p>
      </div>
      <TripFinder destinations={destinations} />
    </div>
  </section>

  <!-- 3c. Destination cheat sheet -->
  <section id="cheat-sheet" class="relative border-t border-[#d5d0c4] bg-white py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-warm mb-4">At a Glance</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">All 12 Destinations, Compared</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Seasons, difficulty, altitude and time needed — the full picture in one table, no clicks required.</p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-[#d5d0c4]/40 bg-white shadow-sm">
        <table class="w-full min-w-[980px] border-collapse text-sm">
          <thead>
            <tr class="bg-[#0f766e] text-left text-white">
              <th class="px-4 py-3.5 font-semibold">Destination</th>
              <th class="px-4 py-3.5 font-semibold">Landscape</th>
              <th class="px-4 py-3.5 font-semibold">Best season</th>
              <th class="px-4 py-3.5 font-semibold">Difficulty</th>
              <th class="px-4 py-3.5 font-semibold">Altitude</th>
              <th class="px-4 py-3.5 font-semibold">Days</th>
              <th class="px-4 py-3.5 font-semibold">Entry fee</th>
              <th class="px-4 py-3.5 font-semibold">Why go</th>
            </tr>
          </thead>
          <tbody>
            {destinations.map((d, i) => (
              <tr class={i % 2 ? "border-t border-[#d5d0c4]/40 bg-[#f8f7f4]/60" : "border-t border-[#d5d0c4]/40"}>
                <td class="px-4 py-3.5 font-semibold text-[#0f766e]">{d.name}{d.url && <a href={d.url} target="_blank" rel="noopener" class="ml-1.5 text-xs text-[#14b8a6] hover:underline" aria-label={`${d.name} guide`}><i class="fa-solid fa-arrow-up-right-from-square"></i></a>}</td>
                <td class="px-4 py-3.5 text-[#5c5a4c]">{d.landscapeLabel}</td>
                <td class="px-4 py-3.5 text-[#5c5a4c]">{d.seasons.map((s) => seasonLabelMap[s]).join(", ")}</td>
                <td class="px-4 py-3.5 text-[#5c5a4c]">{difficultyLabelMap[d.difficulty]}</td>
                <td class="px-4 py-3.5 text-[#5c5a4c]">{altitudeLabelMap[d.altitude]}</td>
                <td class="px-4 py-3.5 font-medium text-[#1c1a16]">{d.days}</td>
                <td class="px-4 py-3.5 text-xs text-[#5c5a4c]">{d.guide.ticket}</td>
                <td class="px-4 py-3.5 text-[#5c5a4c]">{d.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-[#5c5a4c]/70">Costs and logistics change — check the latest ticket prices before you book. Altitude bands: low = below 1,500m.</p>
    </div>
  </section>

  <!-- 3b. Traveler types -->
  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="tag tag-warm mb-4">Who Are You?</span>
        <h2 class="text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Your Type, Your Trip</h2>
        <p class="mt-4 text-lg text-[#5c5a4c]">Different travelers need different landscapes. Pick your type and go.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {travelerTypes.map((t) => (
          <div class="card-playful scroll-reveal rounded-2xl border border-[#d5d0c4]/40 bg-white p-7 shadow-sm">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#ccfbf1]/60 text-[#0f766e]"><i class={`fa-solid ${t.icon} text-xl`}></i></div>
