  { if: "You're a photographer chasing color", then: "Jiuzhaigou in autumn", why: "turquoise lakes at their peak" },
  { if: "You want snow and glaciers", then: "Hailuogou in winter", why: "a low-altitude glacier plus hot springs" },
  { if: "You love wildlife", then: "Chengdu pandas + Wolong", why: "the closest thing to wild pandas" },
  { if: "You fear altitude but want lakes", then: "Jiuzhaigou over Tibet", why: "same wow factor, far lower risk" },
];

// ── Traveler type cards ──
const travelerTypes = [
  { icon: "fa-plane", label: "First-timer", pick: "Guilin & Yangshuo", why: "The easiest intro to China's nature — no altitude, mature infrastructure, and the landscape you already know from photos.", days: "3–4 days" },
  { icon: "fa-camera", label: "Photographer", pick: "Jiuzhaigou + Zhangye Danxia", why: "The two most photogenic spots in China — mirror-still turquoise lakes and airbrushed rainbow cliffs.", days: "4–5 days" },
  { icon: "fa-person-hiking", label: "Hiker", pick: "Huangshan + Tiger Leaping Gorge", why: "Granite summit sunrises and Asia's most famous gorge trail — serious climbs with serious rewards.", days: "4–6 days" },
  { icon: "fa-people-group", label: "Family", pick: "Chengdu pandas + Guilin", why: "Pandas in the morning, bamboo rafts in the afternoon — low effort, high reward for kids.", days: "5–6 days" },
  { icon: "fa-binoculars", label: "Wildlife lover", pick: "Sichuan + Qinghai", why: "Pandas in Sichuan, then Tibetan antelope and snow-leopard country on the plateau.", days: "7–10 days" },
];

// ── Sister-site network (hub ↔ spoke) ──
const sisterSites = [
  { name: "Guilin & Yangshuo", url: "https://guilin-yang-shuo.com", tag: "Karst", desc: "Li River cruises, bamboo rafts and bike rides through rice paddies — the classic China postcard.", icon: "fa-mountain" },
  { name: "Zhangjiajie National Park", url: "https://zhangjiajie-national-park.com", tag: "Mountains", desc: "3,000 sandstone pillars that inspired Avatar — elevators, glass bridges and cloud forests.", icon: "fa-mountain" },
  { name: "Yunnan Province", url: "https://yunnan-province.com", tag: "Plateau & forests", desc: "Stone Forest, rice terraces, tropical Xishuangbanna and the Tibetan town of Shangri-La.", icon: "fa-earth-asia" },
  { name: "Shangri-La", url: "https://shangri-la-yunnan.com", tag: "Plateau", desc: "A Tibetan town at 3,200m — monasteries, alpine lakes and snow-capped gorges.", icon: "fa-snowflake" },
  { name: "Tibet & Lhasa", url: "https://tibet-lhasa-potala.com", tag: "Plateau", desc: "Potala Palace, turquoise sacred lakes and the Roof of the World.", icon: "fa-mountain-sun" },
  { name: "Dunhuang & Jiuquan", url: "https://dunhuang-jiuquan.com", tag: "Deserts", desc: "Singing sand dunes, the Crescent Lake oasis and the Silk Road's Mogao Caves.", icon: "fa-sun" },
  { name: "Dujiangyan Panda Base", url: "https://dujiangyan-panda-base.com", tag: "Wildlife", desc: "See giant pandas up close, with volunteer programs and forested enclosures.", icon: "fa-paw" },
