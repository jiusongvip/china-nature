---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found (404) — China Nature"
  description="The page you are looking for does not exist. Explore China's top 10 natural wonders — Zhangjiajie, Jiuzhaigou, Zhangye Danxia, Guilin and more."
  noindex
>
  <section class="flex min-h-[70dvh] items-center justify-center px-6 pt-24">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-7xl font-bold text-[#0f766e]">404</p>
      <h1 class="mt-4 text-3xl font-bold text-[#1c1a16]">This trail leads nowhere</h1>
      <p class="mt-4 leading-relaxed text-[#5c5a4c]">
        The page you are looking for does not exist or has moved. Head back to the guide and find your perfect Chinese landscape instead.
      </p>
      <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3 font-semibold text-white shadow-md shadow-[#0f766e]/15 transition-all hover:shadow-lg hover:scale-105">
        Explore the Top 10 Natural Wonders
      </a>
    </div>
  </section>
</Layout>
