---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import {
  destinations,
  getDestination,
  getDestinationsByLandscape,
  getSeasonLabel,
  getDifficultyLabel,
  getAltitudeLabel,
} from "../../data/destinations";

export function getStaticPaths() {
  return destinations.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const dest = getDestination(slug!);
if (!dest) return Astro.redirect("/404");

const siteUrl = "https://www.chinanaturetrip.com";
const pageUrl = `${siteUrl}/destinations/${dest.slug}/`;
const title = `${dest.name} Travel Guide 2026: Tickets, Best Time & How to Visit`;
const description = dest.metaDescription
  ?? `${dest.name} in ${dest.guide.location} — how to get there, entry tickets (${dest.guide.ticket}), best season to visit and a day-by-day itinerary, with no tour sales.`;
const heroImg = dest.heroImg ? siteUrl + dest.heroImg : undefined;

const related = getDestinationsByLandscape(dest.landscape)
  .filter((d) => d.slug !== dest.slug)
  .slice(0, 3);

const seasonLabels = dest.seasons.map(getSeasonLabel).join(", ");

const faqSchema = dest.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: dest.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : undefined;
---

<Layout title={title} description={description}>
  <!-- Breadcrumb -->
  <section class="relative border-b border-[#d5d0c4] bg-white pt-28 pb-8">
    <div class="mx-auto max-w-7xl px-6">
      <nav class="flex flex-wrap items-center gap-2 text-sm text-[#5c5a4c]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0f766e]">Home</a>
        <span class="text-[#d5d0c4]">/</span>
        <a href="/explore/" class="hover:text-[#0f766e]">Destinations</a>
        <span class="text-[#d5d0c4]">/</span>
        <span class="font-medium text-[#1c1a16]">{dest.name}</span>
      </nav>
    </div>
  </section>

  <!-- Hero + quick facts -->
  <section class="relative bg-[#f8f7f4] py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2">
          {dest.heroImg && (
            <div class="mb-6 overflow-hidden rounded-2xl border border-[#d5d0c4]/40 shadow-sm">
              <img src={dest.heroImg} alt={dest.heroImgAlt ?? dest.name} class="h-[340px] w-full object-cover md:h-[440px]" loading="eager" width="1280" height="720" />
            </div>
          )}
          <div class="flex items-center gap-3 text-sm">
            <span class="text-xs font-bold uppercase tracking-widest text-[#14b8a6]">Travel Guide</span>
            {dest.rating && (
              <span class="inline-flex items-center gap-1 text-sm font-semibold text-[#1c1a16]">
                <Icon name="fa-star" class="text-[#fbbf24] text-xs" />
                {dest.rating.toFixed(1)} <span class="text-xs text-[#5c5a4c]">/ 10</span>
              </span>
            )}
          </div>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">{dest.name}</h1>
          {dest.tagline && (
            <p class="mt-3 max-w-2xl text-lg leading-relaxed text-[#5c5a4c]">{dest.tagline}</p>
          )}
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#5c5a4c]">{dest.reason}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#ccfbf1]/60 px-3 py-1 text-xs font-semibold text-[#0f766e]"><Icon name="fa-earth-asia" class="text-[10px]" />{dest.landscapeLabel}</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#edeae3] px-3 py-1 text-xs font-semibold text-[#5c5a4c]"><Icon name="fa-person-hiking" class="text-[10px]" />{getDifficultyLabel(dest.difficulty)}</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#edeae3] px-3 py-1 text-xs font-semibold text-[#5c5a4c]"><Icon name="fa-mountain-sun" class="text-[10px]" />{getAltitudeLabel(dest.altitude)}</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#edeae3] px-3 py-1 text-xs font-semibold text-[#5c5a4c]"><Icon name="fa-clock" class="text-[10px]" />{dest.days}</span>
          </div>
        </div>

        <!-- Quick facts sidebar -->
        <aside class="lg:col-span-1">
          <div class="rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm lg:sticky lg:top-24">
            <h2 class="text-sm font-bold uppercase tracking-widest text-[#14b8a6]">At a Glance</h2>
            <div class="mt-4 space-y-3">
              {[
                { label: "Location", value: dest.guide.location, icon: "fa-location-dot" },
                { label: "Entry ticket", value: dest.guide.ticket, icon: "fa-ticket" },
                { label: "Best season", value: seasonLabels, icon: "fa-calendar" },
                { label: "Getting there", value: dest.guide.transport, icon: "fa-train" },
              ].map((row) => (
                <div class="flex items-start gap-3 py-2 border-b border-[#d5d0c4]/50 last:border-0">
                  <span class="mt-0.5 shrink-0 text-[#0f766e]"><Icon name={`fa-${row.icon}`} class="text-sm" /></span>
                  <div class="min-w-0">
                    <div class="text-xs font-semibold uppercase tracking-wider text-[#5c5a4c]">{row.label}</div>
                    <div class="mt-0.5 text-sm text-[#1c1a16]">{row.value}</div>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-4 rounded-xl bg-[#f0fdfa] p-4">
              <div class="flex items-start gap-2">
                <span class="mt-0.5 shrink-0 text-[#14b8a6]"><Icon name="fa-lightbulb" class="text-sm" /></span>
                <p class="text-sm leading-relaxed text-[#5c5a4c]"><strong class="text-[#0f766e]">Local tip:</strong> {dest.guide.tips}</p>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Deep content (only for destinations with a full guide) -->
  {dest.intro ? (
    <section class="relative bg-white py-14 md:py-20">
      <div class="mx-auto max-w-3xl px-6">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-[#1c1a16]">About {dest.name}</h2>
          <p class="mt-4 text-lg leading-relaxed text-[#5c5a4c]">{dest.intro}</p>

          {dest.physical && (
            <div class="mt-12">
              <h2 class="text-3xl font-bold tracking-tight text-[#1c1a16]">Facts at a Glance</h2>
              <p class="mt-3 text-base text-[#5c5a4c]">The physical and historical details of {dest.name} — useful for understanding the landscape and planning your visit.</p>
              <div class="mt-6 overflow-hidden rounded-2xl border border-[#d5d0c4]/40">
                <table class="w-full text-left">
                  <tbody class="divide-y divide-[#d5d0c4]/30">
                    <tr class="bg-[#f8f7f4]">
                      <td class="px-5 py-3 text-sm font-semibold text-[#1c1a16] w-1/3">Landscape type</td>
                      <td class="px-5 py-3 text-sm text-[#5c5a4c]">{dest.physical.type}</td>
                    </tr>
                    <tr>
                      <td class="px-5 py-3 text-sm font-semibold text-[#1c1a16]">Elevation</td>
                      <td class="px-5 py-3 text-sm text-[#5c5a4c]">{dest.physical.elevation}</td>
                    </tr>
                    <tr class="bg-[#f8f7f4]">
                      <td class="px-5 py-3 text-sm font-semibold text-[#1c1a16]">Area</td>
                      <td class="px-5 py-3 text-sm text-[#5c5a4c]">{dest.physical.area}</td>
                    </tr>
                    <tr>
                      <td class="px-5 py-3 text-sm font-semibold text-[#1c1a16]">Climate</td>
                      <td class="px-5 py-3 text-sm text-[#5c5a4c]">{dest.physical.climate}</td>
                    </tr>
                    <tr class="bg-[#f8f7f4]">
                      <td class="px-5 py-3 text-sm font-semibold text-[#1c1a16]">UNESCO status</td>
                      <td class="px-5 py-3 text-sm text-[#5c5a4c]">{dest.physical.unesco}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {dest.culture && (
            <div class="mt-12 rounded-2xl border border-[#14b8a6]/20 bg-gradient-to-br from-[#f0fdfa] to-white p-6">
              <div class="flex items-start gap-3">
                <span class="mt-0.5 shrink-0 text-[#14b8a6]"><Icon name="fa-book-open" class="text-lg" /></span>
                <div>
                  <div class="text-sm font-bold uppercase tracking-widest text-[#0f766e]">Culture & history</div>
                  <p class="mt-2 text-base leading-relaxed text-[#1c1a16]">{dest.culture}</p>
                </div>
              </div>
            </div>
          )}

          {dest.highlights && (
            <>
              <h2 class="mt-12 text-3xl font-bold tracking-tight text-[#1c1a16]">Top things to do</h2>
              <ul class="mt-5 space-y-3">
                {dest.highlights.map((h) => (
                  <li class="flex items-start gap-3 text-[#5c5a4c]">
                    <span class="mt-1 shrink-0 text-[#14b8a6]"><Icon name="fa-check" class="text-sm" /></span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          {dest.howToGetThere && (
            <>
              <h2 class="mt-12 text-3xl font-bold tracking-tight text-[#1c1a16]">How to get there</h2>
              <p class="mt-4 text-lg leading-relaxed text-[#5c5a4c]">{dest.howToGetThere}</p>
            </>
          )}

          {dest.bestTime && (
            <>
              <h2 class="mt-12 text-3xl font-bold tracking-tight text-[#1c1a16]">Best time to visit</h2>
              <p class="mt-4 text-lg leading-relaxed text-[#5c5a4c]">{dest.bestTime}</p>
            </>
          )}

          {dest.whenToGo && dest.whenToGo.length > 0 && (
            <div class="mt-8">
              <h3 class="text-xl font-bold text-[#1c1a16]">Season by season</h3>
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                {dest.whenToGo.map((s) => (
                  <div class="rounded-2xl border border-[#d5d0c4]/40 bg-[#f8f7f4] p-5">
                    <div class="flex items-center justify-between gap-2">
                      <div class="font-bold text-[#1c1a16]">{s.label}</div>
                      <div class="flex items-center gap-1 text-xs font-semibold text-[#0f766e]">
                        <Icon name="fa-star" class="text-[#fbbf24] text-[10px]" />
                        {s.score}/10
                      </div>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{s.text}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {dest.itineraries && (
            <>
              <h2 class="mt-12 text-3xl font-bold tracking-tight text-[#1c1a16]">Suggested itinerary</h2>
              <div class="mt-5 space-y-4">
                {dest.itineraries.map((it, i) => (
                  <div class="rounded-2xl border border-[#d5d0c4]/40 bg-[#f8f7f4] p-5">
                    <div class="flex items-center gap-3">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#0f766e] to-[#2dd4bf] text-sm font-bold text-white">{i + 1}</span>
                      <div>
                        <div class="text-xs font-semibold uppercase tracking-wider text-[#14b8a6]">{it.days}</div>
                        <div class="font-bold text-[#1c1a16]">{it.title}</div>
                      </div>
                    </div>
                    <p class="mt-3 text-sm leading-relaxed text-[#5c5a4c]">{it.detail}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {dest.cost && (
            <div class="mt-12">
              <h2 class="text-3xl font-bold tracking-tight text-[#1c1a16]">What it really costs</h2>
              <p class="mt-3 text-base text-[#5c5a4c]">A realistic per-person day budget for {dest.name}, excluding international flights. Prices in CNY (1 USD ≈ 7.2 CNY).</p>
              <div class="mt-6 grid gap-4 md:grid-cols-3">
                <div class="rounded-2xl border border-[#d5d0c4]/40 bg-white p-5">
                  <div class="text-xs font-bold uppercase tracking-widest text-[#5c5a4c]">Budget</div>
                  <div class="mt-2 text-sm font-semibold text-[#1c1a16]">{dest.cost.budget}</div>
                </div>
                <div class="rounded-2xl border-2 border-[#14b8a6] bg-[#f0fdfa] p-5 shadow-sm">
                  <div class="text-xs font-bold uppercase tracking-widest text-[#0f766e]">Mid-range</div>
                  <div class="mt-2 text-sm font-semibold text-[#1c1a16]">{dest.cost.mid}</div>
                </div>
                <div class="rounded-2xl border border-[#d5d0c4]/40 bg-white p-5">
                  <div class="text-xs font-bold uppercase tracking-widest text-[#5c5a4c]">Splurge</div>
                  <div class="mt-2 text-sm font-semibold text-[#1c1a16]">{dest.cost.splurge}</div>
                </div>
              </div>
            </div>
          )}

          {dest.proTips && dest.proTips.length > 0 && (
            <div class="mt-12">
              <h2 class="text-3xl font-bold tracking-tight text-[#1c1a16]">Editor's pro tips</h2>
              <p class="mt-3 text-base text-[#5c5a4c]">Five things we'd tell a friend before they go — the practical details you won't find in a brochure.</p>
              <ol class="mt-5 space-y-3">
                {dest.proTips.map((tip) => (
                  <li class="flex items-start gap-3 rounded-2xl border border-[#d5d0c4]/40 bg-[#f8f7f4] p-4">
                    <span class="mt-0.5 shrink-0 text-[#14b8a6]"><Icon name="fa-lightbulb" class="text-base" /></span>
                    <span class="text-sm leading-relaxed text-[#1c1a16]">{tip}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="relative bg-white py-14">
      <div class="mx-auto max-w-3xl px-6">
        <div class="rounded-2xl border border-[#d5d0c4]/40 bg-[#f0fdfa] p-8 text-center">
          <h2 class="text-2xl font-bold text-[#1c1a16]">Full guide coming soon</h2>
          <p class="mt-3 text-[#5c5a4c]">We are writing the complete {dest.name} guide — tickets, best time to visit, and a day-by-day itinerary. Check back soon, or explore the other destinations below.</p>
          <a href="/explore/" class="mt-6 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3 text-sm font-semibold text-white shadow-md transition-all hover:scale-105">Explore all destinations <Icon name="fa-arrow-right" class="text-xs" /></a>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {dest.faqs?.length ? (
    <section class="relative bg-[#f8f7f4] py-14 md:py-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="text-3xl font-bold tracking-tight text-[#1c1a16]">Frequently asked questions</h2>
        <div class="mt-6 space-y-4">
          {dest.faqs.map((faq, i) => (
            <details class="group rounded-2xl border border-[#d5d0c4]/40 bg-white p-0 overflow-hidden" open={i === 0}>
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 list-none">
                <span class="font-semibold text-[#1c1a16]">{faq.q}</span>
                <span class="shrink-0 text-[#14b8a6] transition-transform group-open:rotate-45"><Icon name="fa-arrow-right" class="rotate-90 text-xs" /></span>
              </summary>
              <div class="px-5 pb-5 text-[#5c5a4c] leading-relaxed">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <!-- Related destinations -->
  {related.length > 0 && (
    <section class="relative bg-white py-14 md:py-20">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-3xl font-bold tracking-tight text-[#1c1a16]">More {dest.landscapeLabel.toLowerCase()} destinations</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <a href={`/destinations/${r.slug}/`} class="card-playful group block rounded-2xl border border-[#d5d0c4]/40 bg-white p-6 shadow-sm transition-all hover:shadow-md">
              {r.heroImg && <img src={r.heroImg} alt={r.heroImgAlt ?? r.name} class="mb-4 h-40 w-full rounded-xl object-cover" loading="lazy" width="640" height="360" />}
              <h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e]">{r.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#5c5a4c]">{r.reason}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#0f766e]">View guide <Icon name="fa-arrow-right" class="text-xs" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "Destinations", item: `${siteUrl}/explore/` },
      { "@type": "ListItem", position: 3, name: dest.name, item: pageUrl },
    ],
  })} />

  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TouristDestination",
    "@id": pageUrl,
    name: dest.name,
    description: dest.reason,
    url: pageUrl,
    ...(heroImg ? { image: heroImg } : {}),
    address: { "@type": "PostalAddress", addressCountry: "CN" },
    ...(dest.url ? { sameAs: dest.url } : {}),
  })} />
</Layout>
