---
import Layout from "../layouts/Layout.astro";

const title = "About China Nature — Independent Guide to China's Landscapes";
const description = "Who is behind China Nature, our editorial standards, how we research and verify every destination, and why there are no sponsored listings or tour sales.";
---

<Layout title={title} description={description}>
  <section class="relative border-b border-[#d5d0c4] bg-white py-16">
    <div class="mx-auto max-w-3xl px-6">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs font-semibold text-[#78716c]"><a href="/" class="hover:text-[#0f766e]">Home</a> <span class="mx-1">/</span> <span class="text-[#0f766e]">About</span></nav>
      <span class="tag tag-primary mb-4">About Us</span>
      <h1 class="font-display text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">About China Nature</h1>
      <p class="mt-5 text-lg leading-relaxed text-[#5c5a4c]">China Nature is an independent guide to the natural landscapes of China — karst peaks, danxia cliffs, alpine lakes, glaciers, deserts and forests — written by travelers, for travelers.</p>
    </div>
  </section>

  <section class="relative py-16">
    <div class="mx-auto max-w-3xl space-y-10 px-6">
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">Who we are</h2>
        <p class="mt-3 leading-relaxed text-[#5c5a4c]">China Nature is run by <strong>Alex Chen</strong>, a China-based travel writer and photographer who has spent the past decade hiking, driving and photographing the country's wild places — from the karst rivers of Guangxi to the glaciers of Sichuan and the grasslands of Inner Mongolia. Every destination featured on this site has been personally visited.</p>
        <img src="/images/mountains-zhangjiajie.webp" alt="Zhangjiajie's sandstone pillars, among the landscapes documented firsthand for China Nature" class="mt-6 w-full rounded-2xl object-cover shadow-sm" width="1200" height="800" loading="lazy" />
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">Our editorial standards</h2>
        <div class="mt-3 space-y-4 leading-relaxed text-[#5c5a4c]">
          <div>
            <h3 class="text-lg font-semibold text-[#1c1a16]">Firsthand only</h3>
            <p class="mt-1">We write about places we have actually been. Costs, seasons and routes reflect what we would tell a friend.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1c1a16]">No sponsored listings</h3>
            <p class="mt-1">No hotel, agency or park pays for placement. Guide links point to our own sister sites, which follow the same rules.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1c1a16]">Sources cited</h3>
            <p class="mt-1">Heritage designations, park figures and landscape science are checked against authoritative references such as the UNESCO World Heritage Centre.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1c1a16]">Updated regularly</h3>
            <p class="mt-1">Ticket prices, visa rules and transport details are reviewed and refreshed as they change.</p>
          </div>
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">Why no tour sales?</h2>
        <p class="mt-3 leading-relaxed text-[#5c5a4c]">Because most "guides" to China's nature are tour brochures in disguise. We don't sell anything, so we can say which parks are overcrowded, which cable cars are worth it and which season to avoid. Our only goal is helping you plan a better trip.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">Get in touch</h2>
        <p class="mt-3 leading-relaxed text-[#5c5a4c]">Found an out-of-date price or a trail that has changed? <a href="/contact/" class="font-semibold text-[#0f766e] underline hover:no-underline">Contact us</a> — corrections are welcome and appreciated.</p>
      </div>
    </div>
  </section>
</Layout>
