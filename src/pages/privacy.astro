---
import Layout from "../layouts/Layout.astro";

const title = "Privacy Policy — China Nature";
const description = "How China Nature handles data: privacy-respecting analytics, no personal data collection, no ad tracking, and your rights under GDPR and similar laws.";
---

<Layout title={title} description={description}>
  <section class="relative border-b border-[#d5d0c4] bg-white py-16">
    <div class="mx-auto max-w-3xl px-6">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs font-semibold text-[#78716c]"><a href="/" class="hover:text-[#0f766e]">Home</a> <span class="mx-1">/</span> <span class="text-[#0f766e]">Privacy Policy</span></nav>
      <span class="tag tag-primary mb-4">Legal</span>
      <h1 class="font-display text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Privacy Policy</h1>
      <p class="mt-5 text-lg leading-relaxed text-[#5c5a4c]">Last updated: September 5, 2026</p>
    </div>
  </section>

  <section class="relative py-16">
    <div class="mx-auto max-w-3xl space-y-8 px-6 text-[#5c5a4c]">
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">1. Who we are</h2>
        <p class="mt-3 leading-relaxed">China Nature (www.chinanaturetrip.com) is an independent travel guide published by Alex Chen. For any privacy question, contact <a href="mailto:hello@chinanaturetrip.com" class="font-semibold text-[#0f766e] underline hover:no-underline">hello@chinanaturetrip.com</a>.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">2. What we collect</h2>
        <p class="mt-3 leading-relaxed">We do not collect, store or share personal data. There are no accounts, no comment forms and no newsletters on this site. The only form of contact is the email address you choose to write to us from.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">3. Analytics</h2>
        <p class="mt-3 leading-relaxed">We use Google Analytics 4 with IP anonymization to count page views in aggregate. This data is used solely to understand which guides are useful; it is never sold or used for advertising. You can opt out with any standard browser setting or the Google Analytics opt-out add-on.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">4. Cookies and local storage</h2>
        <p class="mt-3 leading-relaxed">The trip-finder tool stores your last selection in your browser's local storage so it can remember your answers between visits. This stays on your device and is never transmitted. No advertising or cross-site tracking cookies are used.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">5. Third-party embeds</h2>
        <p class="mt-3 leading-relaxed">We embed no third-party content. Outbound links to UNESCO and Wikipedia are plain links governed by those sites' own policies.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">6. Your rights</h2>
        <p class="mt-3 leading-relaxed">Under the GDPR and similar laws you may request access to or deletion of any personal data. Since we hold none, there is nothing to request — but if you have emailed us and want the correspondence deleted, write to the address above and we will do it.</p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-[#1c1a16]">7. Changes</h2>
        <p class="mt-3 leading-relaxed">If this policy changes materially, we will update the date above.</p>
      </div>
    </div>
  </section>
</Layout>
