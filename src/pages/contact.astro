---
import Layout from "../layouts/Layout.astro";

const title = "Contact China Nature — Corrections, Questions & Feedback";
const description = "Questions about a destination or an out-of-date price? Contact China Nature by email — we read every message and reply within 2–3 business days.";
---

<Layout title={title} description={description}>
  <section class="relative border-b border-[#d5d0c4] bg-white py-16">
    <div class="mx-auto max-w-3xl px-6">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs font-semibold text-[#78716c]"><a href="/" class="hover:text-[#0f766e]">Home</a> <span class="mx-1">/</span> <span class="text-[#0f766e]">Contact</span></nav>
      <span class="tag tag-primary mb-4">Contact</span>
      <h1 class="font-display text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">Get in Touch</h1>
      <p class="mt-5 text-lg leading-relaxed text-[#5c5a4c]">Questions about a destination, an out-of-date price, or feedback on the guide? We read every email.</p>
    </div>
  </section>

  <section class="relative py-16">
    <div class="mx-auto max-w-3xl space-y-8 px-6">
      <div class="rounded-2xl border border-[#d5d0c4]/40 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-[#1c1a16]">Email us</h2>
        <p class="mt-3 leading-relaxed text-[#5c5a4c]">The fastest way to reach us:</p>
        <p class="mt-4"><a href="mailto:hello@chinanaturetrip.com" class="inline-flex items-center rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3 text-sm font-semibold text-white shadow-md transition-all hover:scale-105">hello@chinanaturetrip.com</a></p>
        <p class="mt-3 text-sm text-[#78716c]">We usually reply within 2–3 business days.</p>
      </div>
      <div class="rounded-2xl border border-[#d5d0c4]/40 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-[#1c1a16]">What to include</h2>
        <div class="mt-3 space-y-4 leading-relaxed text-[#5c5a4c]">
          <div>
            <h3 class="text-lg font-semibold text-[#1c1a16]">Corrections</h3>
            <p class="mt-1">Tell us the page and the figure you believe is wrong, plus a source if you have one.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1c1a16]">Trip questions</h3>
            <p class="mt-1">Share your dates, fitness level and what you most want to see — we'll point you to the right guide.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1c1a16]">Partnerships</h3>
            <p class="mt-1">We don't sell placements, but we do hear about genuine collaboration ideas.</p>
          </div>
        </div>
      </div>
      <p class="text-center text-sm text-[#78716c]">Prefer to browse first? Start with the <a href="/" class="font-semibold text-[#0f766e] underline hover:no-underline">full guide to China's nature</a>.</p>
    </div>
  </section>
</Layout>
