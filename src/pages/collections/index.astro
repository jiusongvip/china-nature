---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { collections } from "../../data/collections";

const title = "China Nature Collections — Destinations by Theme (2026)";
const description =
  "Browse China's natural wonders by theme: UNESCO World Heritage Sites, high-altitude destinations, and first-timer classics — curated to match how you actually plan a trip.";
---

<Layout title={title} description={description}>
  <!-- Breadcrumb -->
  <section class="relative border-b border-[#d5d0c4] bg-white pt-28 pb-8">
    <div class="mx-auto max-w-7xl px-6">
      <nav class="flex flex-wrap items-center gap-2 text-sm text-[#5c5a4c]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0f766e]">Home</a>
        <span class="text-[#d5d0c4]">/</span>
        <span class="font-medium text-[#1c1a16]">Collections</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="relative bg-[#f8f7f4] py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-6">
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-[#1c1a16] md:text-5xl">China's natural wonders, curated by theme</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[#5c5a4c]">
        Instead of a long list of 12 destinations, these collections group them by how people actually search and plan: the UNESCO sites worth a detour, the high-altitude landscapes that need planning, and the three classics every first-timer should see.
      </p>
    </div>
  </section>

  <!-- Collection cards -->
  <section class="relative bg-white py-14 md:py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {collections.map((c) => (
          <a href={`/collections/${c.slug}/`} class="group flex flex-col overflow-hidden rounded-2xl border border-[#d5d0c4]/40 bg-white shadow-sm transition-all hover:border-[#14b8a6] hover:shadow-md">
            <div class={`flex aspect-[16/9] items-center justify-center bg-gradient-to-br ${c.gradient}`}>
              <span class="text-6xl" aria-hidden="true">{c.emoji}</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-lg font-bold text-[#1c1a16] transition-colors group-hover:text-[#0f766e]">{c.name}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[#5c5a4c]">{c.shortDescription}</p>
              <div class="mt-4 flex items-center justify-between">
                <span class="text-xs font-semibold text-[#14b8a6]">{c.destinationSlugs.length} destinations</span>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-[#0f766e]">View <Icon name="fa-arrow-right" class="text-[10px]" /></span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Browse all destinations -->
  <section class="relative bg-[#f8f7f4] py-14">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-2xl font-bold text-[#1c1a16]">Prefer to browse everything?</h2>
      <p class="mt-3 text-[#5c5a4c]">See all 12 destinations grouped by landscape type, or use the trip finder to narrow them down by season and difficulty.</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/explore/" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-6 py-3 text-sm font-semibold text-white shadow-md transition-all hover:scale-105">Explore all destinations <Icon name="fa-arrow-right" class="text-xs" /></a>
        <a href="/#trip-finder" class="inline-flex items-center gap-2 rounded-full border border-[#d5d0c4] bg-white px-6 py-3 text-sm font-semibold text-[#0f766e] transition-all hover:border-[#14b8a6]">Use the trip finder</a>
      </div>
    </div>
  </section>
</Layout>
